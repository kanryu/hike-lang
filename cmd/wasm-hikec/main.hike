// wasm-hikec is the browser-hosted HikeC entry point.
// Package sources are supplied by JavaScript through the WASM loader.
//
// The generated runtime.js provides the host bridge for this Wabt build. The
// host installs __hikeWasmC.wat and a synchronous wat2wasm adapter backed by
// Wabt.js (in Node.js or in a browser bundle).
package main

jfunc wasm_hikec_source() string {
    return runtime.writeString(globalThis.__hikeWasmC.source || "")
}

jfunc wasm_hikec_publish_wat(wat string) int {
    globalThis.__hikeWasmC.wat = runtime.readString(wat)
    return wat.length
}

jfunc wasm_hikec_runtime_init() int {
    if (!globalThis.__hikeWasmC) {
        globalThis.__hikeWasmC = {};
    }
    globalThis.__hikeWasmC.memory = wasmMemory;
    return 1;
}

jfunc wasm_hikec_echo_source_enabled() int {
    if (globalThis.__hikeWasmC.echoSource) { return 1 }
    return 0
}

jfunc wasm_hikec_debug_phase(phase int) int {
    globalThis.__hikeWasmC.debugPhase = phase
    runtime.log("debug-phase", { phase })
    return phase
}

func main() int {
    wasm_hikec_runtime_init()
    source := wasm_hikec_source()
    if wasm_hikec_echo_source_enabled() != 0 {
        return wasm_hikec_publish_wat(source)
    }
    return Compile(source)
}
