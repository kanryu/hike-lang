package lexer

import (
	"hikec/token"
	"std/strings"
)

func malloc(size int) *byte
func free(ptr *byte)
func memcpy(dst *byte, src *byte, n int) *byte

type Lexer struct {
	input        *byte
	inputLen     int
	position     int
	readPosition int
	ch           int
	line         int
	col          int
}

func New(input *byte) *Lexer {
	l := (*Lexer)(malloc(56))
	l.input = input
	l.inputLen = strings.Len(input)
	l.position = 0
	l.readPosition = 0
	l.ch = 0
	l.line = 1
	l.col = 0
	l.readChar()
	return l
}

func (l *Lexer) readChar() {
	if l.readPosition >= l.inputLen {
		l.ch = 0
	} else {
		l.ch = int(l.input[l.readPosition])
	}
	l.position = l.readPosition
	l.readPosition = l.readPosition + 1
	l.col = l.col + 1
}

func (l *Lexer) peekChar() int {
	if l.readPosition >= l.inputLen {
		return 0
	}
	return int(l.input[l.readPosition])
}

func (l *Lexer) skipWhitespace() {
	for l.ch == 32 || l.ch == 9 || l.ch == 10 || l.ch == 13 {
		if l.ch == 10 {
			l.line = l.line + 1
			l.col = 0
		}
		l.readChar()
	}
}

func (l *Lexer) isLetter(ch int) bool {
	return (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95
}

func (l *Lexer) isDigit(ch int) bool {
	return ch >= 48 && ch <= 57
}

func (l *Lexer) readIdentifier() *byte {
	startPos := l.position
	for l.isLetter(l.ch) || l.isDigit(l.ch) {
		l.readChar()
	}
	length := l.position - startPos
	buf := malloc(length + 1)
	memcpy(buf, l.input+startPos, length)
	buf[length] = 0
	return buf
}

func (l *Lexer) readNumber() *byte {
	startPos := l.position
	for l.isDigit(l.ch) {
		l.readChar()
	}
	length := l.position - startPos
	buf := malloc(length + 1)
	memcpy(buf, l.input+startPos, length)
	buf[length] = 0
	return buf
}

func (l *Lexer) readString() *byte {
	l.readChar()
	startPos := l.position
	for l.ch != 34 && l.ch != 0 {
		l.readChar()
	}
	length := l.position - startPos
	buf := malloc(length + 1)
	memcpy(buf, l.input+startPos, length)
	buf[length] = 0
	if l.ch == 34 {
		l.readChar()
	}
	return buf
}

func (l *Lexer) NextToken() *token.Token {
	l.skipWhitespace()

	curLine := l.line
	curCol := l.col
	var tok *token.Token = nil

	if l.ch == 0 {
		tok = token.New(token.EOF, "", curLine, curCol)
	} else if l.ch == 61 { // '='
		if l.peekChar() == 61 {
			l.readChar()
			tok = token.New(token.EQ, "==", curLine, curCol)
		} else {
			tok = token.New(token.ASSIGN, "=", curLine, curCol)
		}
		l.readChar()
	} else if l.ch == 58 { // ':'
		if l.peekChar() == 61 {
			l.readChar()
			tok = token.New(token.DEFINE, ":=", curLine, curCol)
			l.readChar()
		} else {
			tok = token.New(token.COLON, ":", curLine, curCol)
			l.readChar()
		}
	} else if l.ch == 43 { // '+'
		tok = token.New(token.PLUS, "+", curLine, curCol)
		l.readChar()
	} else if l.ch == 45 { // '-'
		tok = token.New(token.MINUS, "-", curLine, curCol)
		l.readChar()
	} else if l.ch == 42 { // '*'
		tok = token.New(token.ASTERISK, "*", curLine, curCol)
		l.readChar()
	} else if l.ch == 47 { // '/'
		tok = token.New(token.SLASH, "/", curLine, curCol)
		l.readChar()
	} else if l.ch == 40 { // '('
		tok = token.New(token.LPAREN, "(", curLine, curCol)
		l.readChar()
	} else if l.ch == 41 { // ')'
		tok = token.New(token.RPAREN, ")", curLine, curCol)
		l.readChar()
	} else if l.ch == 123 { // '{'
		tok = token.New(token.LBRACE, "{", curLine, curCol)
		l.readChar()
	} else if l.ch == 125 { // '}'
		tok = token.New(token.RBRACE, "}", curLine, curCol)
		l.readChar()
	} else if l.ch == 91 { // '['
		tok = token.New(token.LBRACKET, "[", curLine, curCol)
		l.readChar()
	} else if l.ch == 93 { // ']'
		tok = token.New(token.RBRACKET, "]", curLine, curCol)
		l.readChar()
	} else if l.ch == 44 { // ','
		tok = token.New(token.COMMA, ",", curLine, curCol)
		l.readChar()
	} else if l.ch == 59 { // ';'
		tok = token.New(token.SEMICOLON, ";", curLine, curCol)
		l.readChar()
	} else if l.ch == 46 { // '.'
		if l.peekChar() == 46 {
			l.readChar()
			if l.peekChar() == 46 {
				l.readChar()
				tok = token.New(token.ELLIPSIS, "...", curLine, curCol)
				l.readChar()
			} else {
				tok = token.New(token.ILLEGAL, "..", curLine, curCol)
				l.readChar()
			}
		} else {
			tok = token.New(token.DOT, ".", curLine, curCol)
			l.readChar()
		}
	} else if l.ch == 34 { // '"'
		strVal := l.readString()
		tok = token.New(token.STRING, strVal, curLine, curCol)
	} else {
		if l.isLetter(l.ch) {
			lit := l.readIdentifier()
			tokType := token.LookupIdent(lit)
			tok = token.New(tokType, lit, curLine, curCol)
		} else if l.isDigit(l.ch) {
			lit := l.readNumber()
			tok = token.New(token.INT, lit, curLine, curCol)
		} else {
			tok = token.New(token.ILLEGAL, "", curLine, curCol)
			l.readChar()
		}
	}

	return tok
}
