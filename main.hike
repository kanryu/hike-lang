package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running map[K]V Comprehensive Tests ===")
	testCount := 0

	// ==========================================
	// 1. 基本的な代入と参照: make(map[string]int)
	// ==========================================
	scores := make(map[string]int)
	scores["Alice"] = 95
	scores["Bob"] = 80
	scores["Charlie"] = 70

	testCount++
	assert(scores["Alice"] == 95, testCount, "map[string]int: scores['Alice'] == 95")

	testCount++
	assert(scores["Bob"] == 80, testCount, "map[string]int: scores['Bob'] == 80")

	testCount++
	assert(scores["Charlie"] == 70, testCount, "map[string]int: scores['Charlie'] == 70")

	// ==========================================
	// 2. 組み込み関数 len() と値の更新
	// ==========================================
	testCount++
	assert(len(scores) == 3, testCount, "len(scores) == 3")

	scores["Bob"] = 88 // 上書き更新
	testCount++
	assert(scores["Bob"] == 88 && len(scores) == 3, testCount, "Update map key: scores['Bob'] == 88")

	// ==========================================
	// 3. 存在確認（カンマokイディオム）
	// ==========================================
	val1, ok1 := scores["Alice"]
	testCount++
	assert(ok1 && val1 == 95, testCount, "Comma-ok: existing key 'Alice' -> ok == true")

	val2, ok2 := scores["David"]
	testCount++
	assert(!ok2 && val2 == 0, testCount, "Comma-ok: non-existing key 'David' -> ok == false, val == 0")

	// ==========================================
	// 4. 組み込み関数 delete()
	// ==========================================
	delete(scores, "Charlie")
	testCount++
	assert(len(scores) == 2, testCount, "delete(scores, 'Charlie') -> len == 2")

	_, ok3 := scores["Charlie"]
	testCount++
	assert(!ok3, testCount, "Deleted key 'Charlie' -> ok == false")

	// ==========================================
	// 5. 整数キーのマップ: make(map[int]string)
	// ==========================================
	httpStatus := make(map[int]string)
	httpStatus[200] = "OK"
	httpStatus[404] = "Not Found"
	httpStatus[500] = "Internal Server Error"

	testCount++
	assert(httpStatus[200] == "OK" && httpStatus[404] == "Not Found", testCount, "map[int]string: Status code mapping")

	testCount++
	assert(len(httpStatus) == 3, testCount, "len(httpStatus) == 3")

	// ==========================================
	// 6. for k, v := range m 反復走査
	// ==========================================
	counts := make(map[string]int)
	counts["a"] = 10
	counts["b"] = 20
	counts["c"] = 30

	sum := 0
	numItems := 0
	for k, v := range counts {
		sum += v
		numItems++
	}

	testCount++
	assert(sum == 60 && numItems == 3, testCount, "for k, v := range map: sum of values == 60")

	fmt.PrintLn("=== All map[K]V Tests Passed ===")
	return testCount
}
