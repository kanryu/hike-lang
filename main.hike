package main

import "std/map"

func printf(format string, ...) int

type Pair struct {
    key  string
    val  int
    used bool
}

type ArrayMap struct {
    slots [8]Pair
    count int
}

type ArrayMapIter struct {
    cursor int
}

func (m *ArrayMap) Set(key string, val int) {
    for i := 0; i < 8; i = i + 1 {
        if m.slots[i].used && m.slots[i].key == key {
            m.slots[i].val = val
            return
        }
    }
    for i := 0; i < 8; i = i + 1 {
        if !m.slots[i].used {
            m.slots[i].key = key
            m.slots[i].val = val
            m.slots[i].used = true
            m.count = m.count + 1
            return
        }
    }
}

func (m *ArrayMap) Get(key string) (int, bool) {
    for i := 0; i < 8; i = i + 1 {
        if m.slots[i].used && m.slots[i].key == key {
            return m.slots[i].val, true
        }
    }
    return 0, false
}

func (m *ArrayMap) Delete(key string) {
    for i := 0; i < 8; i = i + 1 {
        if m.slots[i].used && m.slots[i].key == key {
            m.slots[i].used = false
            m.slots[i].key = ""
            m.slots[i].val = 0
            m.count = m.count - 1
            return
        }
    }
}

func (m *ArrayMap) Len() int {
    return m.count
}

// Pass 1: buf == nil で必要サイズ (8バイト) を返却
// Pass 2: buf != nil でスタックポインタをキャストして初期化
func (m *ArrayMap) InitIterator(buf *byte) int {
    if buf == nil {
        return 8
    }
    var it *ArrayMapIter = (*ArrayMapIter)(buf)
    it.cursor = 0
    return 0
}

// ゼロコピーで要素ポインタを返却
func (m *ArrayMap) Next(buf *byte) (*string, *int, bool) {
    var it *ArrayMapIter = (*ArrayMapIter)(buf)
    for it.cursor < 8 {
        i := it.cursor
        it.cursor = it.cursor + 1
        if m.slots[i].used {
            return &m.slots[i].key, &m.slots[i].val, true
        }
    }
    return nil, nil, false
}

func main() int {
    printf("=== Testing Custom MapBehavior 2-Pass for-range in Hike ===\n")

    var myMap ArrayMap

    myMap["Alpha"] = 100
    myMap["Beta"] = 200
    myMap["Gamma"] = 300

    printf("[1] Length of myMap: %d\n", len(myMap))

    // ユーザー定義構造体の for-range 走査
    printf("[2] Iterating over myMap using for-range:\n")
    total := 0
    count := 0
    for k, v := range myMap {
        printf("  - %s: %d\n", k, v)
        total = total + v
        count = count + 1
    }

    if count == 3 && total == 600 {
        printf("  -> [PASS] for-range iterated all 3 elements correctly (total=%d)\n", total)
    } else {
        printf("  -> [FAIL] for-range iteration failed (count=%d, total=%d)\n", count, total)
        return 1
    }

    printf("=== All MapBehavior for-range Tests Passed Successfully ===\n")
    return 0
}