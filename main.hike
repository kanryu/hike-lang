package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running String Type & Operation Tests ===")

	testCount := 0

	// 1. 文字列比較 (== / !=)
	s1 := "hello"
	s2 := "hello"
	s3 := "world"

	testCount = testCount + 1
	assert(s1 == s2, testCount, "String Eq: identical strings match")

	testCount = testCount + 1
	assert(s1 != s3, testCount, "String Neq: different strings do not match")

	testCount = testCount + 1
	assert(s1 == "hello", testCount, "String Eq: variable matches string literal")

	// 2. 文字列の長さ取得 (len)
	testCount = testCount + 1
	assert(len(s1) == 5 && len("hike language") == 13, testCount, "String Len: len() returns correct byte length")

	// 3. 文字列のスライス (部分文字列抽出)
	text := "hike-compiler"
	sub1 := text[0:4]  // "hike"
	sub2 := text[5:13] // "compiler"
	sub3 := text[5:]   // "compiler"
	sub4 := text[:4]   // "hike"

	testCount = testCount + 1
	assert(sub1 == "hike" && len(sub1) == 4, testCount, "String Slice: text[0:4] extracted 'hike'")

	testCount = testCount + 1
	assert(sub2 == "compiler" && sub3 == "compiler", testCount, "String Slice: text[5:13] and text[5:] match 'compiler'")

	testCount = testCount + 1
	assert(sub4 == "hike", testCount, "String Slice: text[:4] prefix slice matches 'hike'")

	// 4. 文字列の結合 (+)
	joined := sub1 + " " + sub2

	testCount = testCount + 1
	assert(joined == "hike compiler" && len(joined) == 13, testCount, "String Concat: sub1 + ' ' + sub2 equals 'hike compiler'")

	fmt.PrintLn("=== All String Tests Completed ===")
	return testCount
}
