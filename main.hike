package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func add(a int, b int) int {
	return a + b
}

func applyOp(op func(int, int) int, x int, y int) int {
	return op(x, y)
}

func main() int {
	fmt.PrintLn("=== Running Closure Environment Capture Tests ===")
	testCount := 0

	// ==========================================
	// 1. 単一変数のキャプチャと書き換え
	// ==========================================
	counter := 100
	increment := func(amount int) int {
		counter += amount
		return counter
	}

	res1 := increment(25)
	testCount++
	assert(res1 == 125 && counter == 125, testCount, "Closure: capture counter and mutate (100 -> 125)")

	res2 := increment(10)
	testCount++
	assert(res2 == 135 && counter == 135, testCount, "Closure: subsequent call accumulates counter (125 -> 135)")

	// ==========================================
	// 2. 複数変数のキャプチャ
	// ==========================================
	factor := 3
	base := 50
	calc := func(x int) int {
		return base + (x * factor)
	}

	res3 := calc(10)
	testCount++
	assert(res3 == 80, testCount, "Closure: capture multiple variables (base + x * factor == 80)")

	// ==========================================
	// 3. キャプチャを持つクロージャを高階関数に渡す
	// ==========================================
	total := 0
	accumulateOp := func(a int, b int) int {
		sum := a + b
		total += sum
		return sum
	}

	res4 := applyOp(accumulateOp, 20, 30)
	testCount++
	assert(res4 == 50 && total == 50, testCount, "Closure Callback: applyOp mutates outer total variable")

	// ==========================================
	// 4. トップレベル関数ポインタの Thunk 互換性
	// ==========================================
	res5 := applyOp(add, 40, 60)
	testCount++
	assert(res5 == 100, testCount, "Top-level Function Thunk: applyOp(add, 40, 60) == 100")

	fmt.PrintLn("=== All Closure Tests Completed Successfully ===")
	return testCount
}
