package main

import (
	"std/fmt"
	"std/strconv"
	"std/strings"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running std/strings & std/strconv Comprehensive Tests ===")
	testCount := 0

	// ==========================================
	// 1. std/strings: HasPrefix / HasSuffix
	// ==========================================
	testCount++
	assert(strings.HasPrefix("hello world", "hello"), testCount, "strings.HasPrefix('hello world', 'hello') == true")

	testCount++
	assert(strings.HasSuffix("main.hike", ".hike"), testCount, "strings.HasSuffix('main.hike', '.hike') == true")

	// ==========================================
	// 2. std/strings: Index / Contains / Count
	// ==========================================
	testCount++
	assert(strings.Index("compiler design", "design") == 9, testCount, "strings.Index('compiler design', 'design') == 9")

	testCount++
	assert(strings.Contains("quick brown fox", "brown"), testCount, "strings.Contains('quick brown fox', 'brown') == true")

	testCount++
	assert(strings.Count("banana", "an") == 2, testCount, "strings.Count('banana', 'an') == 2")

	// ==========================================
	// 3. std/strings: Join / Split / Repeat
	// ==========================================
	words := []string{"Go", "Rust", "Hike"}
	joined := strings.Join(words, ", ")
	testCount++
	assert(joined == "Go, Rust, Hike", testCount, "strings.Join(words, ', ') == 'Go, Rust, Hike'")

	parts := strings.Split("a:b:c:d", ":")
	testCount++
	assert(len(parts) == 4 && parts[0] == "a" && parts[3] == "d", testCount, "strings.Split('a:b:c:d', ':') -> length 4")

	repeated := strings.Repeat("Na", 4)
	testCount++
	assert(repeated == "NaNaNaNa", testCount, "strings.Repeat('Na', 4) == 'NaNaNaNa'")

	// ==========================================
	// 4. std/strconv: Itoa / Atoi
	// ==========================================
	s1 := strconv.Itoa(12345)
	testCount++
	assert(s1 == "12345", testCount, "strconv.Itoa(12345) == '12345'")

	s2 := strconv.Itoa(-42)
	testCount++
	assert(s2 == "-42", testCount, "strconv.Itoa(-42) == '-42'")

	n1, err1 := strconv.Atoi("98765")
	testCount++
	assert(err1 == nil && n1 == 98765, testCount, "strconv.Atoi('98765') == 98765")

	n2, err2 := strconv.Atoi("-100")
	testCount++
	assert(err2 == nil && n2 == -100, testCount, "strconv.Atoi('-100') == -100")

	// ==========================================
	// 5. std/strconv: FormatInt / ParseInt (基数変換)
	// ==========================================
	hexStr := strconv.FormatInt(255, 16)
	testCount++
	assert(hexStr == "ff", testCount, "strconv.FormatInt(255, 16) == 'ff'")

	binStr := strconv.FormatInt(10, 2)
	testCount++
	assert(binStr == "1010", testCount, "strconv.FormatInt(10, 2) == '1010'")

	parsedHex, pHexErr := strconv.ParseInt("1a", 16, 64)
	testCount++
	assert(pHexErr == nil && parsedHex == 26, testCount, "strconv.ParseInt('1a', 16, 64) == 26")

	parsedBin, pBinErr := strconv.ParseInt("1101", 2, 64)
	testCount++
	assert(pBinErr == nil && parsedBin == 13, testCount, "strconv.ParseInt('1101', 2, 64) == 13")

	fmt.PrintLn("=== All std/strings & std/strconv Tests Passed ===")
	return testCount
}
