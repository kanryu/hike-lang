package main

import "std/maps"

func printf(format string, ...) int

func main() int {
    printf("=== Testing std/maps Generic Map with 2-Pass Iterator ===\n")

    hmap := maps.New[string, int](8)

    hmap["Tokyo"] = 1400
    hmap["Osaka"] = 880
    hmap["Nagoya"] = 230
    hmap["Fukuoka"] = 160
    hmap["Sapporo"] = 190

    if len(hmap) == 5 {
        printf("  -> [PASS] Length is 5 (len=%d)\n", len(hmap))
    } else {
        printf("  -> [FAIL] Length incorrect: %d\n", len(hmap))
        return 1
    }

    if val, ok := hmap["Osaka"]; ok && val == 880 {
        printf("  -> [PASS] 'Osaka' found with population %d\n", val)
    } else {
        printf("  -> [FAIL] 'Osaka' lookup failed\n")
        return 2
    }

    totalPop := 0
    visitedCount := 0
    for city, pop := range hmap {
        printf("  - %s: %d\n", city, pop)
        totalPop = totalPop + pop
        visitedCount = visitedCount + 1
    }

    if visitedCount == 5 && totalPop == 2860 {
        printf("  -> [PASS] for-range traversed all 5 entries (total=%d)\n", totalPop)
    } else {
        printf("  -> [FAIL] for-range failed\n")
        return 3
    }

    delete(hmap, "Nagoya")
    if _, ok := hmap["Nagoya"]; !ok && len(hmap) == 4 {
        printf("  -> [PASS] 'Nagoya' deleted, len=%d\n", len(hmap))
    }

    printf("=== All std/maps Tests Passed Successfully ===\n")
    return 0
}