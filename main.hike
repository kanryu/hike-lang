package main

type DNode struct {
	val  int
	prev *DNode
	next *DNode
}

type DList struct {
	head  *DNode
	tail  *DNode
	count int
}

// 末尾にノードを追加
func Append(arena *Arena, list *DList, val int) *DNode {
	node, _ := mem.Alloc[DNode](arena)
	node.val = val

	if list.head == nil {
		list.head = node
		list.tail = node
	} else {
		node.prev = list.tail
		list.tail.next = node
		list.tail = node
	}

	list.count = list.count + 1
	return node
}

// 先頭にノードを追加
func Prepend(arena *Arena, list *DList, val int) *DNode {
	node, _ := mem.Alloc[DNode](arena)
	node.val = val

	if list.head == nil {
		list.head = node
		list.tail = node
	} else {
		node.next = list.head
		list.head.prev = node
		list.head = node
	}

	list.count = list.count + 1
	return node
}

// 指定ノードをリストから削除（前後のリンクを繋ぎ替え）
func Remove(list *DList, node *DNode) {
	if node == nil {
		return
	}

	if node.prev != nil {
		node.prev.next = node.next
	} else {
		list.head = node.next
	}

	if node.next != nil {
		node.next.prev = node.prev
	} else {
		list.tail = node.prev
	}

	list.count = list.count - 1
}

// 前方走査で全ノードの値を合計
func SumForward(list *DList) int {
	total := 0
	curr := list.head
	for curr != nil {
		total = total + curr.val
		curr = curr.next
	}
	return total
}

// 後方走査で全ノードの値を合計
func SumBackward(list *DList) int {
	total := 0
	curr := list.tail
	for curr != nil {
		total = total + curr.val
		curr = curr.prev
	}
	return total
}

func main() int {
	arena := mem.NewArena()
	defer arena.FreeAll()

	list, _ := mem.Alloc[DList](arena)

	// 1. ノードの追加: [5, 10, 20, 30, 40]
	Append(arena, list, 10)
	node20 := Append(arena, list, 20)
	Append(arena, list, 30)
	Prepend(arena, list, 5)
	Append(arena, list, 40)

	// 前方合計: 5 + 10 + 20 + 30 + 40 = 105
	fSum1 := SumForward(list)
	// 後方合計: 40 + 30 + 20 + 10 + 5 = 105
	bSum1 := SumBackward(list)

	if fSum1 != 105 {
		return 0
	}
	if bSum1 != 105 {
		return 0
	}
	if list.count != 5 {
		return 0
	}

	// 2. 中間ノード (20) の削除 -> リストは [5, 10, 30, 40]
	Remove(list, node20)

	fSum2 := SumForward(list)  // 5 + 10 + 30 + 40 = 85
	bSum2 := SumBackward(list) // 40 + 30 + 10 + 5 = 85

	if fSum2 != 85 {
		return 0
	}
	if bSum2 != 85 {
		return 0
	}

	// 3. 境界ノード（先頭 5 と末尾 40）の削除 -> リストは [10, 30]
	Remove(list, list.head)
	Remove(list, list.tail)

	fSum3 := SumForward(list)  // 10 + 30 = 40
	bSum3 := SumBackward(list) // 30 + 10 = 40

	if fSum3 != 40 {
		return 0
	}
	if bSum3 != 40 {
		return 0
	}
	if list.count != 2 {
		return 0
	}

	// 総合検証: 85 + 40 + 2 = 127
	totalCheck := fSum2 + fSum3 + list.count
	if totalCheck == 127 {
		return 8
	}

	return 0
}
