package main

import (
	"std/fmt"
	"std/os"
	"std/strings"
)

func malloc(size int) *byte
func free(ptr *byte)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Standard Package Integration Unit Tests ===")

	testCount := 0

	// --- 1〜4: std/fmt パッケージ呼び出し検証 ---
	testCount = testCount + 1
	fmt.PrintStr("")
	assert(true, testCount, "fmt.PrintStr: package function call")

	testCount = testCount + 1
	fmt.PrintInt(42)
	fmt.PrintLn("")
	assert(true, testCount, "fmt.PrintInt: package function call")

	testCount = testCount + 1
	fmt.PrintLn("fmt package println test")
	assert(true, testCount, "fmt.PrintLn: package function call")

	testCount = testCount + 1
	fmt.ErrorLn("fmt package errorln test")
	assert(true, testCount, "fmt.ErrorLn: package function call")

	// --- 5〜7: std/strings パッケージ呼び出し検証 ---
	testCount = testCount + 1
	testStr := "hello hike"
	assert(strings.Len(testStr) == 10, testCount, "strings.Len: package function call")

	testCount = testCount + 1
	assert(strings.Equal(testStr, "hello hike") == true, testCount, "strings.Equal: package function call")

	testCount = testCount + 1
	builder := strings.NewBuilder(16)
	builder.WriteString("hike-")
	builder.WriteString("lang")
	builtStr := builder.String()
	builderMatches := strings.Equal(builtStr, "hike-lang")
	builder.Free()
	assert(builderMatches == true, testCount, "strings.Builder: receiver method call and free")

	// --- 8〜11: std/os 一括ファイルI/O呼び出し検証 ---
	testFile := "test_sample.ll"
	sampleIR := "; ModuleID = 'test'\ntarget triple = \"x86_64-w64-windows-gnu\"\ndefine i32 @main() {\n  ret i32 42\n}\n"
	sampleLen := strings.Len(sampleIR)

	testCount = testCount + 1
	written := os.WriteFile(testFile, sampleIR, sampleLen)
	assert(written == sampleLen, testCount, "os.WriteFile: package function call")

	testCount = testCount + 1
	readContent := os.ReadFile(testFile)
	assert(readContent != nil, testCount, "os.ReadFile: package function call")

	testCount = testCount + 1
	assert(strings.Equal(readContent, sampleIR) == true, testCount, "os.ReadFile: content matches via strings.Equal")

	testCount = testCount + 1
	notFoundContent := os.ReadFile("non_existent_file.hike")
	assert(notFoundContent == nil, testCount, "os.ReadFile: returns nil on non-existent file")

	// --- 12〜15: std/os ストリームファイルI/O呼び出し検証 ---
	testCount = testCount + 1
	f := os.Open(testFile, "rb")
	assert(f != nil, testCount, "os.Open: package function call")

	testCount = testCount + 1
	fNotFound := os.Open("non_existent_file.hike", "rb")
	assert(fNotFound == nil, testCount, "os.Open: returns nil on non-existent file")

	testCount = testCount + 1
	buffer := malloc(32)
	readPartial := f.Read(buffer, 31)
	buffer[readPartial] = 0
	assert(readPartial == 31, testCount, "File.Read: receiver method call")

	testCount = testCount + 1
	closeRes := f.Close()
	assert(closeRes == 0, testCount, "File.Close: receiver method call")

	free(readContent)
	free(buffer)

	fmt.PrintLn("=== Standard Package Integration Unit Tests Completed ===")
	return testCount
}
