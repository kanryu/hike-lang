package main

import (
	"std/fmt"
)

func malloc(size int) *byte

type SliceHeader struct {
	Data *byte
	Len  int
	Cap  int
}

func makeIntSlice(capacity int) []int {
	raw := malloc(capacity * 8)
	header := (*SliceHeader)(malloc(24))
	header.Data = raw
	header.Len = capacity
	header.Cap = capacity
	return *(*[]int)((*byte)(header))
}

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Slice Runtime & Execution Tests ===")

	testCount := 0

	// 1. スライスの作成 (要素数 5)
	s := makeIntSlice(5)

	// テスト1: 初期スライスの len / cap
	testCount = testCount + 1
	assert(len(s) == 5 && cap(s) == 5, testCount, "Slice: initial len and cap match 5")

	// 2. 要素の書き込み
	s[0] = 10
	s[1] = 20
	s[2] = 30
	s[3] = 40
	s[4] = 50

	// テスト2: 書き込んだ要素のインデックス読み出し
	testCount = testCount + 1
	assert(s[0] == 10 && s[2] == 30 && s[4] == 50, testCount, "Slice: read and write element values")

	// 3. スライス式による部分切り出し: sub := s[1:4] (要素: [20, 30, 40], len: 3, cap: 4)
	sub := s[1:4]

	// テスト3: sub スライスの len / cap
	testCount = testCount + 1
	assert(len(sub) == 3 && cap(sub) == 4, testCount, "Slice: sub-slice [1:4] has len=3 and cap=4")

	// テスト4: sub スライスの要素オフセットアクセス
	testCount = testCount + 1
	assert(sub[0] == 20 && sub[1] == 30 && sub[2] == 40, testCount, "Slice: sub-slice elements match original data")

	// 4. 先頭省略スライス: head := s[:3] (要素: [10, 20, 30], len: 3, cap: 5)
	head := s[:3]

	// テスト5: head スライスの検証
	testCount = testCount + 1
	assert(len(head) == 3 && head[2] == 30, testCount, "Slice: head slice [:3] len=3, head[2]=30")

	// 5. 末尾省略スライス: tail := s[2:] (要素: [30, 40, 50], len: 3, cap: 3)
	tail := s[2:]

	// テスト6: tail スライスの検証
	testCount = testCount + 1
	assert(len(tail) == 3 && tail[0] == 30 && tail[2] == 50, testCount, "Slice: tail slice [2:] elements match")

	// 6. スライス経由の変更が元のバッキング配列に波及することの検証
	sub[0] = 999

	// テスト7: sub[0] = 999 が s[1] および head[1] に反映されているか
	testCount = testCount + 1
	assert(s[1] == 999 && head[1] == 999, testCount, "Slice: mutation via slice affects shared backing array")

	fmt.PrintLn("=== Slice Runtime Tests Completed ===")
	return testCount
}
