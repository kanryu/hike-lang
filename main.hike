package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

type Rect struct {
	Width  int
	Height int
}

func inspectType(val any) int {
	switch v := val.(type) {
	case int:
		return v * 2
	case string:
		return 100
	case bool:
		if v {
			return 1
		}
		return 0
	case *Rect:
		return v.Width * v.Height
	default:
		return -1
	}
}

func main() int {
	fmt.PrintLn("=== Running Type Switch Tests ===")
	testCount := 0

	// 1. int 型のマッチングと演算 (v * 2)
	res1 := inspectType(21)
	testCount++
	assert(res1 == 42, testCount, "Type Switch: case int evaluates (21 * 2 == 42)")

	// 2. string 型のマッチング
	res2 := inspectType("hello")
	testCount++
	assert(res2 == 100, testCount, "Type Switch: case string evaluates == 100")

	// 3. bool 型のマッチング
	res3 := inspectType(true)
	testCount++
	assert(res3 == 1, testCount, "Type Switch: case bool evaluates == 1")

	// 4. *Rect 構造体ポインタのマッチングとフィールドアクセス
	r := Rect{Width: 10, Height: 5}
	res4 := inspectType(&r)
	testCount++
	assert(res4 == 50, testCount, "Type Switch: case *Rect evaluates (10 * 5 == 50)")

	// 5. default 節へのフォールバック
	dummyArr := [2]int{1, 2}
	res5 := inspectType(dummyArr)
	testCount++
	assert(res5 == -1, testCount, "Type Switch: default fallback evaluates == -1")

	fmt.PrintLn("=== All Type Switch Tests Passed ===")
	return testCount
}
