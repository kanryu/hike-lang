package main

import (
	"std/fmt"
	"std/math"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func almostEqual(a float64, b float64, eps float64) bool {
	diff := a - b
	if diff < 0.0 {
		diff = -diff
	}
	return diff <= eps
}

func main() int {
	fmt.PrintLn("=== Running std/math Comprehensive Tests ===")
	testCount := 0

	// ==========================================
	// 1. 数学定数
	// ==========================================
	testCount++
	assert(almostEqual(math.Pi, 3.14159265, 0.0001), testCount, "math.Pi ≈ 3.14159")

	testCount++
	assert(almostEqual(math.E, 2.71828182, 0.0001), testCount, "math.E ≈ 2.71828")

	testCount++
	assert(almostEqual(math.Sqrt2, 1.41421356, 0.0001), testCount, "math.Sqrt2 ≈ 1.41421")

	// ==========================================
	// 2. 基本演算: Abs, Sqrt, Pow, Hypot, Mod
	// ==========================================
	testCount++
	assert(math.Abs(-42.5) == 42.5, testCount, "math.Abs(-42.5) == 42.5")

	testCount++
	assert(math.Sqrt(16.0) == 4.0, testCount, "math.Sqrt(16.0) == 4.0")

	testCount++
	assert(math.Pow(2.0, 8.0) == 256.0, testCount, "math.Pow(2.0, 8.0) == 256.0")

	testCount++
	assert(math.Hypot(3.0, 4.0) == 5.0, testCount, "math.Hypot(3.0, 4.0) == 5.0")

	testCount++
	assert(almostEqual(math.Mod(7.5, 2.0), 1.5, 0.0001), testCount, "math.Mod(7.5, 2.0) == 1.5")

	// ==========================================
	// 3. 三角関数: Sin, Cos, Tan
	// ==========================================
	testCount++
	assert(almostEqual(math.Sin(math.Pi/2.0), 1.0, 0.0001), testCount, "math.Sin(Pi/2) == 1.0")

	testCount++
	assert(almostEqual(math.Cos(0.0), 1.0, 0.0001), testCount, "math.Cos(0) == 1.0")

	testCount++
	assert(almostEqual(math.Tan(math.Pi/4.0), 1.0, 0.0001), testCount, "math.Tan(Pi/4) == 1.0")

	// ==========================================
	// 4. 丸め・切捨て: Floor, Ceil, Round, Trunc
	// ==========================================
	testCount++
	assert(math.Floor(3.7) == 3.0, testCount, "math.Floor(3.7) == 3.0")

	testCount++
	assert(math.Ceil(3.2) == 4.0, testCount, "math.Ceil(3.2) == 4.0")

	testCount++
	assert(math.Round(3.5) == 4.0, testCount, "math.Round(3.5) == 4.0")

	testCount++
	assert(math.Trunc(3.9) == 3.0, testCount, "math.Trunc(3.9) == 3.0")

	// ==========================================
	// 5. 指数・対数: Exp, Log, Log10, Log2
	// ==========================================
	testCount++
	assert(almostEqual(math.Exp(1.0), math.E, 0.0001), testCount, "math.Exp(1.0) == math.E")

	testCount++
	assert(almostEqual(math.Log(math.E), 1.0, 0.0001), testCount, "math.Log(math.E) == 1.0")

	testCount++
	assert(almostEqual(math.Log10(100.0), 2.0, 0.0001), testCount, "math.Log10(100.0) == 2.0")

	testCount++
	assert(almostEqual(math.Log2(8.0), 3.0, 0.0001), testCount, "math.Log2(8.0) == 3.0")

	// ==========================================
	// 6. ユーティリティ: Max, Min, Dim
	// ==========================================
	testCount++
	assert(math.Max(10.5, 20.5) == 20.5, testCount, "math.Max(10.5, 20.5) == 20.5")

	testCount++
	assert(math.Min(10.5, 20.5) == 10.5, testCount, "math.Min(10.5, 20.5) == 10.5")

	testCount++
	assert(math.Dim(4.0, -2.0) == 6.0 && math.Dim(-4.0, 2.0) == 0.0, testCount, "math.Dim tests")

	fmt.PrintLn("=== All std/math Tests Passed ===")
	return testCount
}
