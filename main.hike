package main

import (
	"std/fmt"
	"std/os"
)

func main() int {
	fmt.PrintLn("=== Test #13: Standard Library Import Test ===")

	// os パッケージによる動的メモリ確保 (i8* を取得)
	buf := os.Alloc(64)
	fmt.PrintLn("Allocated 64 bytes memory via std/os.")

	// os パッケージによるメモリ解放
	os.Free(buf)
	fmt.PrintLn("Memory freed successfully via std/os.")

	fmt.PrintInt(13)

	// テスト#13成功コード 13 を返却
	return 13
}
