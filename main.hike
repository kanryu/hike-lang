package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Slice Literal & Spread Append Tests ===")

	testCount := 0

	// ==========================================
	// 1. スライスリテラルの初期化検証: []int{...}
	// ==========================================
	s1 := []int{10, 20, 30}

	testCount = testCount + 1
	assert(len(s1) == 3 && cap(s1) == 4, testCount, "Literal: []int{10, 20, 30} has len=3, cap=4")

	testCount = testCount + 1
	assert(s1[0] == 10 && s1[1] == 20 && s1[2] == 30, testCount, "Literal: elements match literal values")

	// 空スライスリテラル
	empty := []int{}
	testCount = testCount + 1
	assert(len(empty) == 0 && cap(empty) == 4, testCount, "Literal: []int{} creates empty slice with default capacity")

	// ==========================================
	// 2. スライス展開結合の検証: append(s1, s2...)
	// ==========================================
	s2 := []int{40, 50, 60}

	// s1(len=3, cap=4) に s2(len=3) を結合 -> 合計 len=6 で cap は 8 に自動拡張
	merged := append(s1, s2...)

	testCount = testCount + 1
	assert(len(merged) == 6 && cap(merged) == 8, testCount, "Spread: append(s1, s2...) results in len=6, cap=8")

	testCount = testCount + 1
	assert(merged[0] == 10 && merged[2] == 30 && merged[3] == 40 && merged[5] == 60, testCount, "Spread: elements correctly merged from both slices")

	// 空スライスへの結合
	merged2 := append(empty, merged...)
	testCount = testCount + 1
	assert(len(merged2) == 6 && merged2[4] == 50, testCount, "Spread: append to empty slice retains merged values")

	fmt.PrintLn("=== All Literal & Spread Tests Completed ===")
	return testCount
}
