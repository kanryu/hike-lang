package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func getPair() (int, string) {
	return 42, "hello"
}

func getThree() (int, int, bool) {
	return 100, 200, true
}

func main() int {
	fmt.PrintLn("=== Running Bitwise Operators & Multi-Value Return Tests ===")
	testCount := 0

	// 1. 二項ビット演算 (AND, OR, XOR, SHL, SHR)
	a := 12 // 0000 1100
	b := 10 // 0000 1010

	testCount++
	assert((a&b) == 8, testCount, "Bitwise AND: 12 & 10 == 8")

	testCount++
	assert((a|b) == 14, testCount, "Bitwise OR: 12 | 10 == 14")

	testCount++
	assert((a^b) == 6, testCount, "Bitwise XOR: 12 ^ 10 == 6")

	testCount++
	assert((a<<2) == 48, testCount, "Bitwise Shift Left: 12 << 2 == 48")

	testCount++
	assert((a>>1) == 6, testCount, "Bitwise Shift Right: 12 >> 1 == 6")

	// 2. 単項ビット反転 (NOT: ^x)
	c := 0
	testCount++
	assert(^c == -1, testCount, "Bitwise NOT: ^0 == -1")

	// 3. 複合ビット代入 (&=, |=, ^=, <<=, >>=)
	x := 12
	x &= 10
	testCount++
	assert(x == 8, testCount, "Compound &=: 12 &= 10 becomes 8")

	x |= 2
	testCount++
	assert(x == 10, testCount, "Compound |=: 8 |= 2 becomes 10")

	x ^= 3
	testCount++
	assert(x == 9, testCount, "Compound ^=: 10 ^= 3 becomes 9")

	x <<= 3
	testCount++
	assert(x == 72, testCount, "Compound <<=: 9 <<= 3 becomes 72")

	x >>= 2
	testCount++
	assert(x == 18, testCount, "Compound >>=: 72 >>= 2 becomes 18")

	// 4. 多値返り値の展開代入 (アンパック代入)
	num, str := getPair()
	testCount++
	assert(num == 42 && str == "hello", testCount, "Multi-Return: num, str := getPair()")

	// 5. 多値返り値とブランク識別子 (_) の組み合わせ
	_, strOnly := getPair()
	testCount++
	assert(strOnly == "hello", testCount, "Multi-Return Blank: _, strOnly := getPair()")

	first, _, flag := getThree()
	testCount++
	assert(first == 100 && flag == true, testCount, "Multi-Return Blank Triple: first, _, flag := getThree()")

	fmt.PrintLn("=== All Tests Completed Successfully ===")
	return testCount
}
