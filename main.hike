package main

import (
	"hikec/ast"
	"hikec/lexer"
	"hikec/parser"
	"std/fmt"
	"std/strings"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Phase 2: AST & Parser Unit Tests ===")

	testCount := 0

	sampleSource := "package main\n\nfunc add(a int, b int) int {\n  x := a + b\n  return x\n}\n"
	lex := lexer.New(sampleSource)
	p := parser.New(lex)
	prog := p.ParseProgram()

	testCount = testCount + 1
	assert(prog != nil, testCount, "Parser.ParseProgram: construct program AST node")

	testCount = testCount + 1
	assert(strings.Equal(prog.Package, "main") == true, testCount, "Parser: parse package identifier 'main'")

	testCount = testCount + 1
	assert(prog.Decls.Len() == 1, testCount, "Parser: collect top-level declaration count")

	testCount = testCount + 1
	fnDecl := (*ast.FuncDecl)(prog.Decls.Get(0))
	assert(fnDecl.Kind == ast.KIND_FUNC_DECL, testCount, "Parser: top-level node is FuncDecl")

	testCount = testCount + 1
	assert(strings.Equal(fnDecl.Name, "add") == true, testCount, "Parser: func name matches 'add'")

	testCount = testCount + 1
	assert(fnDecl.Params.Len() == 2, testCount, "Parser: parse function parameter list length")

	testCount = testCount + 1
	param0 := (*ast.ParamDecl)(fnDecl.Params.Get(0))
	assert(strings.Equal(param0.Name, "a") == true, testCount, "Parser: first parameter name is 'a'")

	testCount = testCount + 1
	assert(fnDecl.ReturnTypes.Len() == 1, testCount, "Parser: parse function return type count")

	testCount = testCount + 1
	body := (*ast.BlockStmt)(fnDecl.Body)
	assert(body != nil && body.Statements.Len() == 2, testCount, "Parser: parse block body with 2 statements")

	testCount = testCount + 1
	stmt0 := (*ast.AssignStmt)(body.Statements.Get(0))
	stmt1 := (*ast.ReturnStmt)(body.Statements.Get(1))
	assert(stmt0.Kind == ast.KIND_ASSIGN_STMT && stmt1.Kind == ast.KIND_RETURN_STMT, testCount, "Parser: statement kinds match AssignStmt and ReturnStmt")

	fmt.PrintLn("=== Phase 2 Unit Tests Completed ===")
	return testCount
}
