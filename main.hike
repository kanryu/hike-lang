package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// 浮動小数点数を返す関数
func calcArea(radius float64) float64 {
	pi := 3.1415926535
	return pi * radius * radius
}

// 構造体での浮動小数点数
type Point2D struct {
	X float64
	Y float64
}

func (p *Point2D) DistanceSq() float64 {
	return (p.X * p.X) + (p.Y * p.Y)
}

func main() int {
	fmt.PrintLn("=== Running Floating-Point (float32 / float64) Tests ===")
	testCount := 0

	// ==========================================
	// 1. 基本的な四則演算
	// ==========================================
	a := 1.5
	b := 2.5
	sum := a + b
	testCount++
	assert(sum == 4.0, testCount, "float64 Addition: 1.5 + 2.5 == 4.0")

	diff := b - a
	testCount++
	assert(diff == 1.0, testCount, "float64 Subtraction: 2.5 - 1.5 == 1.0")

	prod := a * 2.0
	testCount++
	assert(prod == 3.0, testCount, "float64 Multiplication: 1.5 * 2.0 == 3.0")

	div := 7.5 / 2.5
	testCount++
	assert(div == 3.0, testCount, "float64 Division: 7.5 / 2.5 == 3.0")

	// ==========================================
	// 2. 比較演算 (<, >, <=, >=, ==, !=)
	// ==========================================
	testCount++
	assert(1.5 < 2.5 && 3.14 > 2.71, testCount, "float64 Comparison: (< and >)")

	testCount++
	assert(2.0 <= 2.0 && 5.0 >= 4.9, testCount, "float64 Comparison: (<= and >=)")

	testCount++
	assert(1.23 != 4.56, testCount, "float64 Comparison: (!=)")

	// ==========================================
	// 3. 型キャスト (int ↔ float64, float32 ↔ float64)
	// ==========================================
	intVal := 42
	castFloat := float64(intVal)
	testCount++
	assert(castFloat == 42.0, testCount, "Type Cast: int(42) -> float64(42.0)")

	floatVal := 9.99
	castInt := int(floatVal)
	testCount++
	assert(castInt == 9, testCount, "Type Cast: float64(9.99) -> int(9)")

	var f32 float32 = float32(3.5)
	f64 := float64(f32)
	testCount++
	assert(f64 == 3.5, testCount, "Type Cast: float32(3.5) -> float64(3.5)")

	// ==========================================
	// 4. 関数呼び出しと実数計算
	// ==========================================
	area := calcArea(2.0)
	testCount++
	assert(area > 12.56 && area < 12.57, testCount, "Function: calcArea(2.0) ≈ 12.566")

	// ==========================================
	// 5. 構造体フィールドとメソッド
	// ==========================================
	pt := Point2D{X: 3.0, Y: 4.0}
	distSq := pt.DistanceSq()
	testCount++
	assert(distSq == 25.0, testCount, "Struct Method: pt.DistanceSq() == 25.0")

	fmt.PrintLn("=== All Floating-Point Tests Passed ===")
	return testCount
}
