package main

type TreeNode struct {
	val   int
	left  *TreeNode
	right *TreeNode
}

type QueueNode struct {
	treeNode *TreeNode
	next     *QueueNode
}

type Queue struct {
	head *QueueNode
	tail *QueueNode
	size int
}

// キューの末尾にツリーノードを追加
func Enqueue(arena *Arena, q *Queue, tn *TreeNode) {
	if tn == nil {
		return
	}

	qn, _ := mem.Alloc[QueueNode](arena)
	qn.treeNode = tn

	if q.head == nil {
		q.head = qn
		q.tail = qn
	} else {
		q.tail.next = qn
		q.tail = qn
	}

	q.size = q.size + 1
}

// キューの先頭からツリーノードを取り出し
func Dequeue(q *Queue) *TreeNode {
	if q.head == nil {
		return nil
	}

	res := q.head.treeNode
	q.head = q.head.next

	if q.head == nil {
		q.tail = nil
	}

	q.size = q.size - 1
	return res
}

// 幅優先探索（BFS: Breadth-First Search）による走査
// 訪問順にステップ番号の重みを掛けて合計値を計算
func BFSWeightedSum(arena *Arena, root *TreeNode) int {
	if root == nil {
		return 0
	}

	q, _ := mem.Alloc[Queue](arena)
	Enqueue(arena, q, root)

	weightedSum := 0
	step := 1

	for q.size > 0 {
		curr := Dequeue(q)

		// 訪問順: 10 -> 20 -> 30 -> 40 -> 50 -> 60
		weightedSum = weightedSum + (curr.val * step)
		step = step + 1

		if curr.left != nil {
			Enqueue(arena, q, curr.left)
		}
		if curr.right != nil {
			Enqueue(arena, q, curr.right)
		}
	}

	return weightedSum
}

func main() int {
	arena := mem.NewArena()
	defer arena.FreeAll()

	// 以下の木構造を構築:
	//          10
	//        /    \
	//      20      30
	//     /  \       \
	//    40   50      60

	n10, _ := mem.Alloc[TreeNode](arena)
	n10.val = 10

	n20, _ := mem.Alloc[TreeNode](arena)
	n20.val = 20

	n30, _ := mem.Alloc[TreeNode](arena)
	n30.val = 30

	n40, _ := mem.Alloc[TreeNode](arena)
	n40.val = 40

	n50, _ := mem.Alloc[TreeNode](arena)
	n50.val = 50

	n60, _ := mem.Alloc[TreeNode](arena)
	n60.val = 60

	// 木構造の連結
	n10.left = n20
	n10.right = n30

	n20.left = n40
	n20.right = n50

	n30.right = n60

	// BFS走査実行
	// 計算式: (10*1) + (20*2) + (30*3) + (40*4) + (50*5) + (60*6)
	// = 10 + 40 + 90 + 160 + 250 + 360 = 910
	result := BFSWeightedSum(arena, n10)

	// 重み付き走査結果が 910 ならテスト#9成功として「9」を返す
	if result == 910 {
		return 9
	}

	return 0
}
