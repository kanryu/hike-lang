package main

import (
	"std/fmt"
)

func malloc(size int) *byte

type SliceHeader struct {
	Data *byte
	Len  int
	Cap  int
}

func makeEmptySlice() []int {
	header := (*SliceHeader)(malloc(24))
	header.Data = nil
	header.Len = 0
	header.Cap = 0
	return *(*[]int)((*byte)(header))
}

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Slice Advanced & Edge-Case Tests ===")

	testCount := 0

	// ==========================================
	// 検証1: 基底配列の共有検証 (サブスライスへの append による親配列の上書き)
	// ==========================================
	orig := makeEmptySlice()
	orig = append(orig, 100, 200, 300, 400, 500) // len=5, cap=8

	sub := orig[1:3]       // sub=[200, 300], len=2, cap=7 (共有配列)
	sub = append(sub, 999) // cap内なので再確保されず orig[3] (400) が 999 に上書きされる

	testCount = testCount + 1
	assert(sub[2] == 999 && orig[3] == 999, testCount, "Verify 1: append within sub-slice capacity overwrites parent backing array at index 3")

	// ==========================================
	// 検証2: 複数要素の一括追加 append(s, e1, e2, e3, e4)
	// ==========================================
	multi := makeEmptySlice()
	multi = append(multi, 10, 20, 30) // 一括で 3 要素追加 (len=3, cap=4)

	testCount = testCount + 1
	assert(len(multi) == 3 && cap(multi) == 4 && multi[0] == 10 && multi[1] == 20 && multi[2] == 30, testCount, "Verify 2-A: append 3 elements at once")

	// さらに容量(4)を超える 4 要素を一括追加 (len=3+4=7, 拡張後のcap=8)
	multi = append(multi, 40, 50, 60, 70)

	testCount = testCount + 1
	assert(len(multi) == 7 && cap(multi) == 8 && multi[3] == 40 && multi[6] == 70, testCount, "Verify 2-B: multi-element append exceeding capacity grows to cap=8")

	// ==========================================
	// 検証3: 大量データ連続追加と多段階拡張 (100要素ループ)
	// ==========================================
	large := makeEmptySlice()
	for i := 0; i < 100; i = i + 1 {
		large = append(large, i*3)
	}

	testCount = testCount + 1
	assert(len(large) == 100 && cap(large) >= 100, testCount, "Verify 3-A: loop append 100 elements reaches len=100")

	// 先頭、中間、末尾データの整合性検証
	testCount = testCount + 1
	assert(large[0] == 0 && large[50] == 150 && large[99] == 297, testCount, "Verify 3-B: all elements in large slice retain correct values after multiple reallocations")

	fmt.PrintLn("=== All Advanced Tests Completed ===")
	return testCount
}
