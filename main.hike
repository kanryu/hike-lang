package main

// トークン種別
// 1: 即値(Number), 2: 加算(+), 3: 減算(-), 4: 乗算(*), 5: 除算(/)
type Token struct {
	kind int
	val  int
	next *Token
}

type StackNode struct {
	val  int
	next *StackNode
}

type Stack struct {
	top  *StackNode
	size int
}

func Push(arena *Arena, s *Stack, val int) {
	node, _ := mem.Alloc[StackNode](arena)
	node.val = val
	node.next = s.top
	s.top = node
	s.size = s.size + 1
}

func Pop(s *Stack) int {
	if s.top == nil {
		return 0
	}
	val := s.top.val
	s.top = s.top.next
	s.size = s.size - 1
	return val
}

// トークン列の末尾に追加するヘルパー関数
func AddToken(arena *Arena, head *Token, kind int, val int) *Token {
	tok, _ := mem.Alloc[Token](arena)
	tok.kind = kind
	tok.val = val

	if head == nil {
		return tok
	}

	curr := head
	for curr.next != nil {
		curr = curr.next
	}
	curr.next = tok
	return head
}

// RPN式の評価実行
func EvalRPN(arena *Arena, tokens *Token) int {
	s, _ := mem.Alloc[Stack](arena)
	curr := tokens

	for curr != nil {
		switch curr.kind {
		case 1:
			// 数値トークン: スタックへプッシュ
			Push(arena, s, curr.val)
		case 2:
			// 加算: b + a
			a := Pop(s)
			b := Pop(s)
			Push(arena, s, b+a)
		case 3:
			// 減算: b - a
			a := Pop(s)
			b := Pop(s)
			Push(arena, s, b-a)
		case 4:
			// 乗算: b * a
			a := Pop(s)
			b := Pop(s)
			Push(arena, s, b*a)
		case 5:
			// 除算: b / a
			a := Pop(s)
			b := Pop(s)
			Push(arena, s, b/a)
		default:
			return 0
		}
		curr = curr.next
	}

	return Pop(s)
}

func main() int {
	arena := mem.NewArena()
	defer arena.FreeAll()

	// 評価するRPN式: 15 3 2 + * 10 - 2 /
	// 中置換算: ((15 * (3 + 2)) - 10) / 2
	// 計算手順:
	// 1. 3 + 2 = 5
	// 2. 15 * 5 = 75
	// 3. 75 - 10 = 65
	// 4. 65 / 2 = 32
	tokens := AddToken(arena, nil, 1, 15)
	AddToken(arena, tokens, 1, 3)
	AddToken(arena, tokens, 1, 2)
	AddToken(arena, tokens, 2, 0) // '+'
	AddToken(arena, tokens, 4, 0) // '*'
	AddToken(arena, tokens, 1, 10)
	AddToken(arena, tokens, 3, 0) // '-'
	AddToken(arena, tokens, 1, 2)
	AddToken(arena, tokens, 5, 0) // '/'

	result := EvalRPN(arena, tokens)

	// 計算結果が 32 であればテスト#10成功として「10」を返す
	if result == 32 {
		return 10
	}

	return 0
}
