package main

import (
	"std/fmt"
)

type Counter struct {
	Value int
}

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Compound Assignment & Inc/Dec Tests ===")

	testCount := 0

	// 1. 変数のインクリメント・デクリメント
	x := 10
	x++
	x++
	testCount++
	assert(x == 12, testCount, "Inc: x++ from 10 twice becomes 12")

	x--
	testCount++
	assert(x == 11, testCount, "Dec: x-- from 12 becomes 11")

	// 2. 変数の複合代入 (+=, -=, *=, /=)
	x += 9 // 20
	testCount++
	assert(x == 20, testCount, "Compound +=: 11 += 9 becomes 20")

	x -= 5 // 15
	testCount++
	assert(x == 15, testCount, "Compound -=: 20 -= 5 becomes 15")

	x *= 3 // 45
	testCount++
	assert(x == 45, testCount, "Compound *=: 15 *= 3 becomes 45")

	x /= 9 // 5
	testCount++
	assert(x == 5, testCount, "Compound /=: 45 /= 9 becomes 5")

	// 3. 構造体フィールドへの ++, +=
	c := Counter{Value: 100}
	c.Value++
	c.Value += 49
	testCount++
	assert(c.Value == 150, testCount, "Struct Field: c.Value++ and += 49 becomes 150")

	// 4. スライス要素への ++, +=
	s := []int{10, 20, 30}
	s[0]++
	s[1] += 80
	testCount++
	assert(s[0] == 11 && s[1] == 100, testCount, "Slice Elem: s[0]++ and s[1] += 80 work correctly")

	// 5. for ループ後処理節での i++
	sum := 0
	for i := 0; i < 5; i++ {
		sum += i
	}
	testCount++
	assert(sum == 10, testCount, "For Loop Post: for i := 0; i < 5; i++ correctly sums to 10")

	fmt.PrintLn("=== All Compound Assignment Tests Completed ===")
	return testCount
}
