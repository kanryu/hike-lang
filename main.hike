package main

import (
	"hikec/lexer"
	"hikec/token"
	"std/container"
	"std/fmt"
	"std/strings"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Phase 1: Vector & Lexer Unit Tests ===")

	testCount := 0

	// --- 1〜5: std/container/vector の検証 ---
	testCount = testCount + 1
	vec := container.NewVector(4)
	assert(vec != nil, testCount, "Vector: allocation with initial capacity")

	testCount = testCount + 1
	vec.Push("token_func")
	vec.Push("token_ident")
	vec.Push("token_lparen")
	assert(vec.Len() == 3, testCount, "Vector.Push: push elements within capacity")

	testCount = testCount + 1
	elem0 := vec.Get(0)
	assert(strings.Equal(elem0, "token_func") == true, testCount, "Vector.Get: retrieve element by index")

	testCount = testCount + 1
	// 容量4を超過させて動的リサイズ（拡張）を発生させる
	vec.Push("token_rparen")
	vec.Push("token_lbrace")
	vec.Push("token_return")
	assert(vec.Len() == 6, testCount, "Vector.Push: dynamic array reallocation beyond capacity")

	testCount = testCount + 1
	elem5 := vec.Get(5)
	vec.Free()
	assert(strings.Equal(elem5, "token_return") == true, testCount, "Vector: data integrity after growth and free")

	// --- 6〜10: hikec/lexer の検証 ---
	testCount = testCount + 1
	sampleCode := "package main\n\nfunc add(a int, b int) int {\n  x := 42\n  return a + b + x\n}\n"
	lex := lexer.New(sampleCode)
	assert(lex != nil, testCount, "Lexer.New: initialize lexer instance")

	testCount = testCount + 1
	t1 := lex.NextToken()
	assert(t1.Type == token.PACKAGE, testCount, "Lexer.NextToken: tokenize keyword 'package'")

	testCount = testCount + 1
	t2 := lex.NextToken()
	assert(t2.Type == token.IDENT && strings.Equal(t2.Literal, "main") == true, testCount, "Lexer.NextToken: tokenize identifier 'main'")

	testCount = testCount + 1
	t3 := lex.NextToken()
	assert(t3.Type == token.FUNCTION, testCount, "Lexer.NextToken: tokenize keyword 'func'")

	testCount = testCount + 1
	t4 := lex.NextToken()
	assert(t4.Type == token.IDENT && strings.Equal(t4.Literal, "add") == true, testCount, "Lexer.NextToken: tokenize identifier 'add'")

	fmt.PrintLn("=== Phase 1 Unit Tests Completed ===")
	return testCount
}
