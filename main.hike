package main

import (
	"calc"
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn(getBanner())
	testCount := 0

	// ==========================================
	// 1. 同一パッケージ内別ファイル (helper.hike) の関数呼び出し
	// ==========================================
	multRes := helperMultiply(6, 7)
	testCount++
	assert(multRes == 42, testCount, "Same Package Multi-File: helperMultiply(6, 7) == 42")

	// ==========================================
	// 2. 外部パッケージ (calc) の関数と定数
	// ==========================================
	addRes := calc.Add(calc.DefaultBase, 50)
	testCount++
	assert(addRes == 150, testCount, "External Package Func & Const: calc.Add(calc.DefaultBase, 50) == 150")

	subRes := calc.Sub(100, 30)
	testCount++
	assert(subRes == 70, testCount, "External Package Func: calc.Sub(100, 30) == 70")

	// ==========================================
	// 3. 外部パッケージの構造体とメソッド呼び出し・ミューテーション
	// ==========================================
	vec := calc.Vector{X: 3, Y: 4}
	lenSq := vec.LengthSq()
	testCount++
	assert(lenSq == 25, testCount, "External Package Struct & Method: vec.LengthSq() == 25")

	vec.Scale(2)
	testCount++
	assert(vec.X == 6 && vec.Y == 8, testCount, "External Package Method Mutation: vec.Scale(2) -> (6, 8)")

	fmt.PrintLn("=== All Multi-File & Multi-Package Tests Passed ===")
	return testCount
}
