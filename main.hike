package main

import (
	"std/fmt"
)

func malloc(size int) *byte

type SliceHeader struct {
	Data *byte
	Len  int
	Cap  int
}

func makeEmptySlice() []int {
	header := (*SliceHeader)(malloc(24))
	header.Data = nil
	header.Len = 0
	header.Cap = 0
	return *(*[]int)((*byte)(header))
}

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Append Builtin Unit Tests ===")

	testCount := 0

	// 1. 空スライス (len=0, cap=0) への初回 append
	s := makeEmptySlice()
	s = append(s, 100)

	// テスト1: 初回 append 後の len=1, cap=4
	testCount = testCount + 1
	assert(len(s) == 1 && cap(s) == 4 && s[0] == 100, testCount, "Append: initial append on empty slice sets len=1, cap=4")

	// 2. キャパシティ内での連続 append (cap=4 の範囲内)
	s = append(s, 200)
	s = append(s, 300)
	s = append(s, 400)

	// テスト2: cap=4 上限まで追加したときの検証
	testCount = testCount + 1
	assert(len(s) == 4 && cap(s) == 4, testCount, "Append: append up to capacity preserves cap=4 and len=4")

	// テスト3: 格納された各要素値の検証
	testCount = testCount + 1
	assert(s[0] == 100 && s[1] == 200 && s[2] == 300 && s[3] == 400, testCount, "Append: elements within capacity match expected values")

	// 3. キャパシティ超過による自動拡張 (4 -> 8)
	s = append(s, 500)

	// テスト4: 自動拡張後の len=5, cap=8
	testCount = testCount + 1
	assert(len(s) == 5 && cap(s) == 8, testCount, "Append: exceeding capacity triggers reallocation to cap=8")

	// テスト5: 拡張後も過去データと新データが保持されているか検証
	testCount = testCount + 1
	assert(s[0] == 100 && s[3] == 400 && s[4] == 500, testCount, "Append: reallocated slice retains old data and appends new element")

	// 4. スライス切り出し結果への append
	sub := s[1:3] // [200, 300], len=2, cap=7
	sub = append(sub, 999)

	// テスト6: sub への append (len=3, sub[2]=999)
	testCount = testCount + 1
	assert(len(sub) == 3 && sub[2] == 999, testCount, "Append: append to sub-slice works correctly")

	fmt.PrintLn("=== Append Unit Tests Completed ===")
	return testCount
}
