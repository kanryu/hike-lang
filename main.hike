package main

import (
	"std/errors"
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// 1. 標準的な多値返却と errors.New
func divide(a int, b int) (int, error) {
	if b == 0 {
		return 0, errors.New("division by zero")
	}
	return a / b, nil
}

// 2. カスタムエラー構造体
type CustomError struct {
	Code int
	Msg  *byte
}

func (c *CustomError) Error() *byte {
	return c.Msg
}

func parseCode(code int) (int, error) {
	if code < 0 {
		return 0, &CustomError{Code: 400, Msg: "negative code not allowed"}
	}
	return code * 10, nil
}

func main() int {
	fmt.PrintLn("=== Running Error Handling & Multi-Value Return Tests ===")
	testCount := 0

	// Test 1: 正常系 (divide 10 / 2 -> 5, err == nil)
	val1, err1 := divide(10, 2)
	testCount++
	assert(val1 == 5 && err1 == nil, testCount, "Success Case: divide(10, 2) == (5, nil)")

	// Test 2: 異常系 (divide 10 / 0 -> err != nil)
	val2, err2 := divide(10, 0)
	testCount++
	assert(val2 == 0 && err2 != nil, testCount, "Error Case: divide(10, 0) returns non-nil error")

	// Test 3: error インターフェースの Error() メソッド呼び出し
	errMsg := err2.Error()
	fmt.PrintStr("Captured Error: ")
	fmt.PrintLn(errMsg)
	testCount++
	assert(errMsg != nil, testCount, "Error Method Dispatch: err.Error() returns message")

	// Test 4: カスタムエラー構造体と多値返却
	val3, err3 := parseCode(-1)
	testCount++
	assert(val3 == 0 && err3 != nil, testCount, "Custom Error: parseCode(-1) returns CustomError")

	// Test 5: 型スイッチによる具象エラーのアンパック
	var customCode int = 0
	switch e := err3.(type) {
	case *CustomError:
		customCode = e.Code
	default:
		customCode = -1
	}
	testCount++
	assert(customCode == 400, testCount, "Type Switch on error: extracted CustomError.Code == 400")

	fmt.PrintLn("=== All Error Handling Tests Passed ===")
	return testCount
}
