package main

import (
	"std/fmt"
	"std/io"
	"std/os"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// io.Writer インターフェース経由での書き込みテスト
func writeMessage(w io.Writer, msg *byte) (int, error) {
	b := []byte(msg)
	return w.Write(b)
}

// io.Reader インターフェース経由での読み込みテスト
func readMessage(r io.Reader, size int) ([]byte, int, error) {
	buf := make([]byte, size)
	n, err := r.Read(buf)
	return buf, n, err
}

func main() int {
	fmt.PrintLn("=== Running std/os & std/io Comprehensive Tests ===")
	testCount := 0

	// ==========================================
	// 1. os.Args CLI引数テスト
	// ==========================================
	testCount++
	assert(len(os.Args) >= 1, testCount, "os.Args: length is at least 1 (program name)")
	fmt.PrintStr("Program Executable: ")
	fmt.PrintLn(os.Args[0])

	// ==========================================
	// 2. os.Create と File.WriteString
	// ==========================================
	fileName := "test_output.txt"
	f, err := os.Create(fileName)
	testCount++
	assert(err == nil && f != nil, testCount, "os.Create: created test_output.txt")

	written, wErr := f.WriteString("Hello Hike Standard Library!")
	testCount++
	assert(wErr == nil && written == 28, testCount, "File.WriteString: wrote 28 bytes")
	f.Close()

	// ==========================================
	// 3. os.Open と File.Read (バッファ読み込み)
	// ==========================================
	fOpen, oErr := os.Open(fileName)
	testCount++
	assert(oErr == nil && fOpen != nil, testCount, "os.Open: opened test_output.txt")

	readBuf := make([]byte, 64)
	nRead, rErr := fOpen.Read(readBuf)
	testCount++
	assert(rErr == nil && nRead == 28, testCount, "File.Read: read exactly 28 bytes")
	fOpen.Close()

	// ==========================================
	// 4. io.Writer / io.Reader インターフェース適合
	// ==========================================
	fOut, _ := os.Create("test_io.txt")
	wn, iwErr := writeMessage(fOut, "Interface I/O Works!")
	fOut.Close()
	testCount++
	assert(iwErr == nil && wn == 20, testCount, "io.Writer Interface Dispatch to *os.File")

	fIn, _ := os.Open("test_io.txt")
	inBuf, inN, irErr := readMessage(fIn, 32)
	fIn.Close()
	testCount++
	assert(irErr == nil && inN == 20, testCount, "io.Reader Interface Dispatch to *os.File")
	fmt.PrintStr("Read Content: ")
	fmt.PrintLn(string(inBuf[0:inN]))

	// ==========================================
	// 5. os.WriteFile / os.ReadFile 便利関数
	// ==========================================
	testData := []byte("Convenient File I/O")
	wfErr := os.WriteFile("test_helper.txt", testData)
	testCount++
	assert(wfErr == nil, testCount, "os.WriteFile: wrote file successfully")

	readData, rfErr := os.ReadFile("test_helper.txt")
	testCount++
	assert(rfErr == nil && len(readData) == 19, testCount, "os.ReadFile: read file content correctly")

	fmt.PrintLn("=== All std/os & std/io Tests Passed ===")
	return testCount
}
