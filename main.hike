package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Break, Continue & Init-Statement Branch Tests ===")

	testCount := 0

	// 1. 3節 for ループ内での break
	sumBreak := 0
	for i := 0; i < 10; i++ {
		if i == 5 {
			break
		}
		sumBreak += i
	}
	testCount++
	assert(sumBreak == 10, testCount, "For Break: loop stopped at i == 5, sum is 10")

	// 2. 3節 for ループ内での continue
	sumContinue := 0
	for i := 0; i < 6; i++ {
		if i == 3 {
			continue
		}
		sumContinue += i
	}
	testCount++
	assert(sumContinue == 12, testCount, "For Continue: skipped i == 3, sum is 12")

	// 3. for ... range ループ内での break
	nums := []int{10, 20, 30, 40, 50}
	rangeBreakSum := 0
	for _, v := range nums {
		if v == 40 {
			break
		}
		rangeBreakSum += v
	}
	testCount++
	assert(rangeBreakSum == 60, testCount, "For-Range Break: stopped at v == 40, sum is 60")

	// 4. for ... range ループ内での continue
	rangeContinueSum := 0
	for _, v := range nums {
		if v == 20 || v == 40 {
			continue
		}
		rangeContinueSum += v
	}
	testCount++
	assert(rangeContinueSum == 90, testCount, "For-Range Continue: skipped 20 and 40, sum is 90")

	// 5. 初期化付き if 文: if init; cond { ... }
	testCount++
	if val := 50; val > 30 {
		assert(val == 50, testCount, "If Init: val := 50 scoped in if condition")
	} else {
		assert(false, testCount, "If Init: unreachable else")
	}

	// 6. 初期化付き switch 文: switch init; expr { ... }
	testCount++
	switch code := 200; code {
	case 200:
		assert(code == 200, testCount, "Switch Init: code := 200 matched case 200")
	default:
		assert(false, testCount, "Switch Init: unreachable default")
	}

	fmt.PrintLn("=== All Tests Completed Successfully ===")
	return testCount
}
