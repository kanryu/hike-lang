package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// 1. メソッドセット付きインターフェース
type Shape interface {
	Area() int
	Scale(factor int) int
}

// 2. 具象型 Rect
type Rect struct {
	Width  int
	Height int
}

func (r *Rect) Area() int {
	return r.Width * r.Height
}

func (r *Rect) Scale(factor int) int {
	return r.Width * factor
}

// 3. 具象型 Circle
type Circle struct {
	Radius int
}

func (c *Circle) Area() int {
	return 3 * c.Radius * c.Radius
}

func (c *Circle) Scale(factor int) int {
	return c.Radius * factor
}

// 4. インターフェースを受け取るポリモーフィック関数
func computeArea(s Shape) int {
	return s.Area()
}

func computeScale(s Shape, factor int) int {
	return s.Scale(factor)
}

func main() int {
	fmt.PrintLn("=== Running Interface Method Set & Dynamic Dispatch Tests ===")
	testCount := 0

	rect := Rect{Width: 10, Height: 20}
	circle := Circle{Radius: 5}

	// ==========================================
	// 1. インターフェース型変数への代入と動的ディスパッチ
	// ==========================================
	var s Shape = &rect
	area1 := s.Area()
	testCount++
	assert(area1 == 200, testCount, "Dynamic Dispatch: rect.Area() through Shape == 200")

	scale1 := s.Scale(3)
	testCount++
	assert(scale1 == 30, testCount, "Dynamic Dispatch: rect.Scale(3) through Shape == 30")

	// ==========================================
	// 2. 別の具象型への差し替えと動的ディスパッチ
	// ==========================================
	s = &circle
	area2 := s.Area()
	testCount++
	assert(area2 == 75, testCount, "Dynamic Dispatch: circle.Area() through Shape == 75")

	scale2 := s.Scale(4)
	testCount++
	assert(scale2 == 20, testCount, "Dynamic Dispatch: circle.Scale(4) through Shape == 20")

	// ==========================================
	// 3. 引数としてのインターフェース受け渡し
	// ==========================================
	polyArea1 := computeArea(&rect)
	testCount++
	assert(polyArea1 == 200, testCount, "Polymorphic Arg: computeArea(&rect) == 200")

	polyArea2 := computeArea(&circle)
	testCount++
	assert(polyArea2 == 75, testCount, "Polymorphic Arg: computeArea(&circle) == 75")

	// ==========================================
	// 4. メソッド付きインターフェースからの型アサーション
	// ==========================================
	var testShape Shape = &rect
	resRect, okRect := testShape.(*Rect)
	testCount++
	assert(okRect == true && resRect.Width == 10, testCount, "Type Assertion: testShape.(*Rect) successfully unpacks struct")

	resCircle, okCircle := testShape.(*Circle)
	testCount++
	assert(okCircle == false, testCount, "Type Assertion Mismatch: testShape.(*Circle) returns ok == false")

	fmt.PrintLn("=== All Interface & Dynamic Dispatch Tests Passed ===")
	return testCount
}
