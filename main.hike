package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// 1. 基礎構造体 Engine
type Engine struct {
	Power int
	Fuel  int
}

func (e *Engine) Start() int {
	return e.Power + 10
}

func (e *Engine) AddFuel(amount int) int {
	e.Fuel += amount
	return e.Fuel
}

// 2. 埋め込み構造体 Car
type Car struct {
	Engine // 無名埋め込み
	Doors  int
}

// Car 独自のメソッド
func (c *Car) GetDoors() int {
	return c.Doors
}

// 3. インターフェース Starter (Engine.Start を昇格して満たす)
type Starter interface {
	Start() int
}

func testStarter(s Starter) int {
	return s.Start()
}

func main() int {
	fmt.PrintLn("=== Running Struct Embedding & Promotion Tests ===")
	testCount := 0

	car := Car{
		Engine: Engine{Power: 200, Fuel: 50},
		Doors:  4,
	}

	// ==========================================
	// 1. フィールドの自動昇格（読み取り）
	// ==========================================
	p := car.Power // car.Engine.Power から昇格
	testCount++
	assert(p == 200, testCount, "Field Promotion Read: car.Power == 200")

	// 明示的アクセスとの一致
	testCount++
	assert(car.Engine.Fuel == 50 && car.Fuel == 50, testCount, "Explicit and Promoted Field Match: 50")

	// ==========================================
	// 2. フィールドの自動昇格（書き換え）
	// ==========================================
	car.Power = 350
	testCount++
	assert(car.Power == 350 && car.Engine.Power == 350, testCount, "Field Promotion Mutate: car.Power = 350")

	car.Fuel += 25
	testCount++
	assert(car.Fuel == 75 && car.Engine.Fuel == 75, testCount, "Field Promotion Compound: car.Fuel += 25 (75)")

	// ==========================================
	// 3. メソッドの自動昇格（呼び出しとミューテーション）
	// ==========================================
	startRes := car.Start() // car.Engine.Start() へ自動中継
	testCount++
	assert(startRes == 360, testCount, "Method Promotion: car.Start() == 360")

	fuelRes := car.AddFuel(15) // car.Engine.AddFuel(15)
	testCount++
	assert(fuelRes == 90 && car.Fuel == 90, testCount, "Method Promotion Mutates State: car.AddFuel(15) == 90")

	doors := car.GetDoors()
	testCount++
	assert(doors == 4, testCount, "Direct Method: car.GetDoors() == 4")

	// ==========================================
	// 4. メソッド昇格によるインターフェース適合
	// ==========================================
	var s Starter = &car
	polyRes := testStarter(s)
	testCount++
	assert(polyRes == 360, testCount, "Interface Dispatch with Promoted Method: testStarter(&car) == 360")

	fmt.PrintLn("=== All Struct Embedding Tests Passed ===")
	return testCount
}
