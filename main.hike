package main

import (
	"std/fmt"
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

// ==========================================
// 1. ジェネリック関数 (関数テンプレート)
// ==========================================
func Min[T](a T, b T) T {
	if a < b {
		return a
	}
	return b
}

func Identity[T](val T) T {
	return val
}

// ==========================================
// 2. 単一型パラメータを持つジェネリック構造体
// ==========================================
type Box[T] struct {
	Value T
}

// ==========================================
// 3. 複数型パラメータを持つジェネリック構造体
// ==========================================
type Pair[K, V] struct {
	Key   K
	Val   V
}

func main() int {
	fmt.PrintLn("=== Running Generics (Monomorphization) Comprehensive Tests ===")
	testCount := 0

	// 1. ジェネリック関数 (明示的な型指定)
	minInt := Min[int](10, 20)
	testCount++
	assert(minInt == 10, testCount, "Generic func Min[int](10, 20) == 10")

	minFloat := Min[float64](3.14, 1.59)
	testCount++
	assert(minFloat == 1.59, testCount, "Generic func Min[float64](3.14, 1.59) == 1.59")

	// 2. ジェネリック関数 (引数からの型推論)
	inferredStr := Identity("Hike Generics")
	testCount++
	assert(inferredStr != nil, testCount, "Generic func Identity with type inference (string)")

	inferredInt := Identity(999)
	testCount++
	assert(inferredInt == 999, testCount, "Generic func Identity with type inference (int)")

	// 3. 単一型パラメータのジェネリック構造体
	intBox := Box[int]{Value: 42}
	testCount++
	assert(intBox.Value == 42, testCount, "Generic struct Box[int].Value == 42")

	strBox := Box[string]{Value: "Packed"}
	testCount++
	assert(strBox.Value != nil, testCount, "Generic struct Box[string].Value == 'Packed'")

	// 4. 複数型パラメータのジェネリック構造体 (Pair[string, int])
	pair := Pair[string, int]{Key: "UserID", Val: 1001}
	testCount++
	assert(pair.Val == 1001, testCount, "Generic struct Pair[string, int]: Val == 1001")

	// 5. 複数型パラメータのジェネリック構造体 (Pair[int, float64])
	numPair := Pair[int, float64]{Key: 1, Val: 99.5}
	testCount++
	assert(numPair.Key == 1 && numPair.Val == 99.5, testCount, "Generic struct Pair[int, float64]: (1, 99.5)")

	fmt.PrintLn("=== All Generics Tests Passed ===")
	return testCount
}