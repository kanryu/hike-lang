package main

import (
	"std/fmt"
)

// 1. const (...) ブロックと iota
const (
	STATUS_OK = iota
	STATUS_CREATED
	STATUS_ACCEPTED
	STATUS_BAD_REQUEST  = 400
	STATUS_UNAUTHORIZED = 401
)

func assert(cond bool, testNum int, testName *byte) {
	if cond {
		fmt.PrintStr("[PASS #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	} else {
		fmt.PrintStr("[FAIL #")
		fmt.PrintInt(testNum)
		fmt.PrintStr("] ")
		fmt.PrintLn(testName)
	}
}

func main() int {
	fmt.PrintLn("=== Running Const/iota, For-Range & Blank Identifier Tests ===")

	testCount := 0

	// ==========================================
	// 1. const (...) ブロック & iota テスト
	// ==========================================
	testCount++
	assert(STATUS_OK == 0, testCount, "Const/iota: STATUS_OK == 0")

	testCount++
	assert(STATUS_CREATED == 1, testCount, "Const/iota: STATUS_CREATED == 1")

	testCount++
	assert(STATUS_ACCEPTED == 2, testCount, "Const/iota: STATUS_ACCEPTED == 2")

	testCount++
	assert(STATUS_BAD_REQUEST == 400, testCount, "Const: STATUS_BAD_REQUEST == 400")

	testCount++
	assert(STATUS_UNAUTHORIZED == 401, testCount, "Const: STATUS_UNAUTHORIZED == 401")

	// ==========================================
	// 2. ブランク識別子 (_) テスト
	// ==========================================
	_ = 9999
	_ = "ignored message"
	testCount++
	assert(true, testCount, "Blank Identifier: _ = expr executes without error")

	// ==========================================
	// 3. for ... range ループ テスト
	// ==========================================
	nums := []int{10, 20, 30}

	// 3-A. インデックス & 値 (for i, v := range nums)
	sumVal := 0
	sumIdx := 0
	for i, v := range nums {
		sumIdx += i
		sumVal += v
	}
	testCount++
	assert(sumIdx == 3 && sumVal == 60, testCount, "For-Range: for i, v := range nums correctly iterates index and values")

	// 3-B. インデックスのみ (for i := range nums)
	idxCount := 0
	for i := range nums {
		idxCount += i
	}
	testCount++
	assert(idxCount == 3, testCount, "For-Range: for i := range nums iterates keys")

	// 3-C. ブランク識別子との併用 (for _, v := range nums)
	valOnlySum := 0
	for _, v := range nums {
		valOnlySum += v
	}
	testCount++
	assert(valOnlySum == 60, testCount, "For-Range: for _, v := range nums ignores index and sums values")

	fmt.PrintLn("=== All Tests Completed Successfully ===")
	return testCount
}
