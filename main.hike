package main

import (
	"std/fmt"
)

var traceStep int = 0

func logStep(expectedStep int, name *byte) {
	traceStep++
	if traceStep == expectedStep {
		fmt.PrintStr("[PASS] Defer Order Step ")
		fmt.PrintInt(traceStep)
		fmt.PrintStr(": ")
		fmt.PrintLn(name)
	} else {
		fmt.PrintStr("[FAIL] Defer Order Mismatch: expected ")
		fmt.PrintInt(expectedStep)
		fmt.PrintStr(", got ")
		fmt.PrintInt(traceStep)
		fmt.PrintStr(" (")
		fmt.PrintLn(name)
	}
}

func testDeferLIFO() int {
	defer logStep(3, "First defer registered -> executed 3rd (last)")
	defer logStep(2, "Second defer registered -> executed 2nd")
	defer logStep(1, "Third defer registered -> executed 1st")

	fmt.PrintLn("--> Function body executing...")
	return 100
}

func testEarlyReturn(flag bool) int {
	defer logStep(4, "Early return defer cleanup")
	if flag {
		return 42
	}
	return 0
}

func main() int {
	fmt.PrintLn("=== Running Generic Defer Tests ===")

	res := testDeferLIFO()
	if res == 100 {
		fmt.PrintLn("[PASS] Return value preserved after defers")
	}

	testEarlyReturn(true)

	fmt.PrintLn("=== All Generic Defer Tests Passed ===")
	return 0
}
