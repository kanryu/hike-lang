package main

extern func printf(format cstring, ...) int

// The source allocation belongs to the ordinary Hike slice, so cbuffer must
// not release it. This callback intentionally does nothing.
func release() {}

func main() int {
    printf(cstring("[cbuffer] create source slice\n"))
    source := make([]byte, 4)
    source[0] = 7
    source[1] = 8
    source[2] = 9
    source[3] = 10

    printf(cstring("[cbuffer] construct from ordinary slice\n"))
    buffer := cbuffer(&source[0], len(source), release)
    if buffer.Len() != 4 { return 1 }

    printf(cstring("[cbuffer] index access\n"))
    if buffer[0] != 7 { return 1 }

    printf(cstring("[cbuffer] copy slice\n"))
    copied := buffer[1:3]
    if len(copied) != 2 || copied[0] != 8 || copied[1] != 9 { return 1 }

    printf(cstring("[cbuffer] close\n"))
    buffer.Close()
    if buffer.Len() != 0 { return 1 }

    // The original ordinary slice still owns its storage.
    if source[0] != 7 || source[3] != 10 { return 1 }
    printf(cstring("[cbuffer] verified\n"))
    return 0
}
