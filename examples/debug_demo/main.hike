package main

func printf(format string, ...) int

func Calculate(base int, multiplier int) int {
    result := 0
    for i := 1; i <= multiplier; i = i + 1 {
        result = result + (base * i)
    }
    return result
}

func main() int {
    printf("=== Starting Hike Debug Demo ===\n")

    val := 10
    total := Calculate(val, 5)

    printf("Calculated Total = %d\n", total)
    printf("=== End of Hike Debug Demo ===\n")
    return 0
}