package main

func printf(format string, ...) int

type Block struct{}
type FuncDecl struct {
    Body *Block
    Name string
}
type CFuncDecl struct{}
type TypeDecl struct { Name string }
type VarDecl struct { Name string }
type ConstDecl struct { Name string }

func manglePackageDecls(pkgName string, decls []any) int {
    count := 0
    for _, decl := range decls {
        switch d := decl.(type) {
        case *FuncDecl:
            if d.Body != nil && (pkgName != "main" || d.Name != "main") {
                d.Name = pkgName + "_" + d.Name
            }
        case *CFuncDecl:
            count = count + 1
        case *TypeDecl:
            if pkgName != "main" {
                d.Name = pkgName + "_" + d.Name
            }
        case *VarDecl:
            if pkgName != "main" {
                d.Name = pkgName + "_" + d.Name
            }
        case *ConstDecl:
            if pkgName != "main" {
                d.Name = pkgName + "_" + d.Name
            }
        default:
            count = count + 1
        }
        count = count + 1
    }
    return count
}

func collectFiles(entries []string) int {
    fileQueue := []string{}
    for _, entry := range entries {
        files := []string{entry}
        fileQueue = append(fileQueue, files...)
    }
    return len(fileQueue)
}

func main() int {
    entries := []string{"loader.go"}
    return manglePackageDecls("loader", []any{}) + collectFiles(entries)
}
