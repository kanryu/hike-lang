
package main

func printf(format string, ...) int

func Add(a int, b int) int {
    return a + b
}

func Sub(a int, b int) int {
    return a - b
}

func ExecOp(op func(int, int) int, x int, y int) int {
    return op(x, y)
}

func main() int {
    var fn func(int, int) int = Add
    r1 := fn(30, 20)
    r2 := ExecOp(Sub, 30, 20)
    printf("ADD=%d,SUB=%d\n", r1, r2)
    return 0
}