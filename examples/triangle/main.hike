jfunc webgpu_create_buffer(context int, size int, usage int) int {
    return globalThis.__hikeTriangle.createBuffer(context, size, usage);
}

jfunc webgpu_write_buffer(context int, buffer int, data *float32, count int) {
    globalThis.__hikeTriangle.writeBuffer(context, buffer, data, count);
}

jfunc webgpu_create_shader_module(context int, code string, codeLen int) int {
    return globalThis.__hikeTriangle.createShaderModule(context, code, codeLen);
}

jfunc webgpu_create_render_pipeline(context int, shader int, stride int) int {
    return globalThis.__hikeTriangle.createRenderPipeline(context, shader, stride);
}

jfunc webgpu_create_bind_group(context int, pipeline int, uniformBuffer int) int {
    return globalThis.__hikeTriangle.createBindGroup(context, pipeline, uniformBuffer);
}

jfunc webgpu_command_draw(context int, pipeline int, bindGroup int, vertexBuffer int, vertexCount int) {
    globalThis.__hikeTriangle.commandDraw(context, pipeline, bindGroup, vertexBuffer, vertexCount);
}

jfunc webgpu_resize_context(context int, width int, height int) {
    var ctx = globalThis.__hikeTriangle.contexts.get(Number(context));
    if (!ctx || !ctx.canvas) { return; }
    ctx.width = Number(width); ctx.height = Number(height);
    ctx.canvas.width = ctx.width; ctx.canvas.height = ctx.height;
    if (ctx.ready) {
        var configureDescriptor = Object.create(null);
        configureDescriptor.device = ctx.device; configureDescriptor.format = ctx.format; configureDescriptor.alphaMode = "opaque";
        ctx.gpuContext.configure(configureDescriptor);
    }
}

jfunc webgpu_destroy_context(context int) {
    var ctx = globalThis.__hikeTriangle.contexts.get(Number(context));
    if (ctx && ctx.device) { ctx.device.destroy(); }
    globalThis.__hikeTriangle.contexts.delete(Number(context));
}

var context int
var vertexBuffer int
var uniformBuffer int
var pipeline int
var bindGroup int

cfunc InitApp() {
    vertices := []float32{
        0.0, 0.8, 0.0, 1.0, 0.2, 0.3,
        -0.69282, -0.4, 0.0, 0.2, 1.0, 0.4,
        0.69282, -0.4, 0.0, 0.2, 0.5, 1.0,
    }
    shaderCode := "struct Uniforms { angle: f32, };\n@group(0) @binding(0) var<uniform> uniforms: Uniforms;\nstruct VertexOutput { @builtin(position) position: vec4<f32>, @location(0) color: vec3<f32>, };\n@vertex fn vs(@location(0) position: vec3<f32>, @location(1) color: vec3<f32>) -> VertexOutput {\nlet c = cos(uniforms.angle); let s = sin(uniforms.angle);\nlet x = c * position.x - s * position.y;\nlet y = s * position.x + c * position.y;\nvar output: VertexOutput; output.position = vec4<f32>(x, y, position.z, 1.0);\noutput.color = color; return output; }\n@fragment fn fs(input: VertexOutput) -> @location(0) vec4<f32> { return vec4<f32>(input.color, 1.0); }"
    context = webgpu_create_context("gpu-canvas", 10, 960, 640)
    vertexBuffer = webgpu_create_buffer(context, 72, 40)
    webgpu_write_buffer(context, vertexBuffer, &vertices[0], len(vertices))
    uniformBuffer = webgpu_create_buffer(context, 16, 72)
    shader := webgpu_create_shader_module(context, shaderCode, len(shaderCode))
    pipeline = webgpu_create_render_pipeline(context, shader, 24)
    bindGroup = webgpu_create_bind_group(context, pipeline, uniformBuffer)
}

cfunc RenderFrame(angle float64) {
    if context != 0 {
        uniform := []float32{float32(angle)}
        webgpu_write_buffer(context, uniformBuffer, &uniform[0], len(uniform))
        webgpu_command_draw(context, pipeline, bindGroup, vertexBuffer, 3)
    }
}

cfunc Resize(width int, height int) {
    if context != 0 { webgpu_resize_context(context, width, height); }
}

cfunc Shutdown() {
    if context != 0 {
        webgpu_destroy_context(context)
        context = 0
    }
}
