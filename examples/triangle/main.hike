                runtime.log("webgpu:shader:source", { length: code.length, code: code });
                var id = ctx.nextObject; ctx.nextObject = ctx.nextObject + 1; ctx.objects.set(id, null);
                globalThis.__hikeTriangle.dispatch(ctx, function() {
                    var descriptor = Object.create(null); descriptor.code = code;
                    ctx.objects.set(id, ctx.device.createShaderModule(descriptor));
                });
                return id;
            },
            createRenderPipeline: function(handle, shader, stride) {
                var ctx = globalThis.__hikeTriangle.contexts.get(Number(handle));
                if (!ctx) { return 0; }
                var id = ctx.nextObject; ctx.nextObject = ctx.nextObject + 1; ctx.objects.set(id, null);
                globalThis.__hikeTriangle.dispatch(ctx, function() {
                    var module = ctx.objects.get(Number(shader));
                    var attribute0 = Object.create(null); attribute0.shaderLocation = 0; attribute0.offset = 0; attribute0.format = "float32x3";
                    var attribute1 = Object.create(null); attribute1.shaderLocation = 1; attribute1.offset = 12; attribute1.format = "float32x3";
                    var attributes = []; attributes.push(attribute0); attributes.push(attribute1);
                    var bufferLayout = Object.create(null); bufferLayout.arrayStride = Number(stride); bufferLayout.attributes = attributes;
                    var buffers = []; buffers.push(bufferLayout);
                    var vertex = Object.create(null); vertex.module = module; vertex.entryPoint = "vs"; vertex.buffers = buffers;
                    var target = Object.create(null); target.format = ctx.format;
                    var targets = []; targets.push(target);
                    var fragment = Object.create(null); fragment.module = module; fragment.entryPoint = "fs"; fragment.targets = targets;
                    var primitive = Object.create(null); primitive.topology = "triangle-list";
                    var descriptor = Object.create(null); descriptor.layout = "auto"; descriptor.vertex = vertex; descriptor.fragment = fragment; descriptor.primitive = primitive;
                    ctx.objects.set(id, ctx.device.createRenderPipeline(descriptor));
                });
                return id;
            },
            createBindGroup: function(handle, pipeline, uniformBuffer) {
                var ctx = globalThis.__hikeTriangle.contexts.get(Number(handle));
                if (!ctx) { return 0; }
                var id = ctx.nextObject; ctx.nextObject = ctx.nextObject + 1; ctx.objects.set(id, null);
                globalThis.__hikeTriangle.dispatch(ctx, function() {
                    var pipelineObject = ctx.objects.get(Number(pipeline));
                    var resource = Object.create(null); resource.buffer = ctx.objects.get(Number(uniformBuffer));
                    var entry = Object.create(null); entry.binding = 0; entry.resource = resource;
                    var entries = []; entries.push(entry);
                    var descriptor = Object.create(null); descriptor.layout = pipelineObject.getBindGroupLayout(0); descriptor.entries = entries;
                    ctx.objects.set(id, ctx.device.createBindGroup(descriptor));
                });
                return id;
            },
            commandDraw: function(handle, pipeline, bindGroup, vertexBuffer, vertexCount) {
                var ctx = globalThis.__hikeTriangle.contexts.get(Number(handle));
                if (!ctx || !ctx.ready) { return; }
                var encoder = ctx.device.createCommandEncoder();
                var attachment = Object.create(null);
                attachment.view = ctx.gpuContext.getCurrentTexture().createView();
                var clearValue = Object.create(null); clearValue.r = 0.03; clearValue.g = 0.05; clearValue.b = 0.1; clearValue.a = 1;
                attachment.clearValue = clearValue; attachment.loadOp = "clear"; attachment.storeOp = "store";
