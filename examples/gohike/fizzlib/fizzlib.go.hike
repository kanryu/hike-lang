package fizzlib

// 外部C実装(c_fizzlib.c)の宣言からGoラッパーとWindows ABIスタブを生成する。

// 1. GetFizzFileSize: 文字列引数と整数戻り値
cfunc GetFizzFileSize(fn_ptr cstring, fn_len int) int {
    return fn_len + 100
}

// 1b. C側がNUL終端されたC stringを実際に走査する
cfunc StringLength(value cstring) int = c_StringLength

// 1c. C側でcharポインターを加工せず、そのまま返す
cfunc EchoString(value cstring) cstring = c_EchoString

// 1d. C側でcharポインターを標準出力へ直接出力する
cfunc PrintString(value cstring) int = c_PrintString

// 2. ReadFizzFile: 文字列、整数、ポインター引数
cfunc ReadFizzFile(fn_ptr cstring, readSize int, buf *byte) int {
    return readSize
}

// 3. GetMetaData: C文字列ポインター戻り値と out parameter
passthrough cfunc GetMetaData(fn_ptr cstring, fn_len int, outLen *int) cstring {
    *outLen = 8
    return cstring("fizzbuzz")
}
