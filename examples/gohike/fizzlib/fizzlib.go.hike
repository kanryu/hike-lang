package fizzlib

// 1. GetFizzFileSize: 通常 cfunc
cfunc GetFizzFileSize(fn_ptr cstring, fn_len int) int {
    return 15
}

// 2. ReadFizzFile: 通常 cfunc
cfunc ReadFizzFile(fn_ptr cstring, fn_len int, readSize int, buf *byte) int {
    if readSize <= 0 {
        return 0
    }

    for i := 0; i < readSize; i++ {
        buf[i] = byte(65 + (i % 26))
    }

    return readSize
}

// 3. GetMetaData: passthrough cfunc（Goroutine スタックで直接超高速実行）
passthrough cfunc GetMetaData(fn_ptr cstring, fn_len int, outLen *int) cstring {
    *outLen = 4
    return "fizz"
}

// 4. free: 通常 cfunc
cfunc free(ptr *byte) {
}