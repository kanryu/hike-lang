// Package webgpu provides a small, browser-facing WebGPU rendering API.
//
// The WebGPU objects are owned by the JavaScript host. Hike exposes opaque
// integer handles so the same module can be compiled to wasm32 without
// exposing browser object layouts to the language runtime.
package webgpu

extern func webgpu_create_context(canvas string, canvasLen int, width int, height int) int
extern func webgpu_resize_context(context int, width int, height int)
extern func webgpu_destroy_context(context int)
extern func webgpu_render_triangle(context int, angle float64)

// NewContext creates a WebGPU context for the canvas identified by its DOM id.
func NewContext(canvasID string, width int, height int) int {
	return webgpu_create_context(canvasID, len(canvasID), width, height)
}

// Resize updates the canvas backing size and its WebGPU viewport.
func Resize(context int, width int, height int) {
	if context == 0 { return }
	webgpu_resize_context(context, width, height)
}

// RenderTriangle draws the animated, vertex-colored triangle at angle radians.
func RenderTriangle(context int, angle float64) {
	if context == 0 { return }
	webgpu_render_triangle(context, angle)
}

// Close releases the browser-side WebGPU resources.
func Close(context int) {
	if context == 0 { return }
	webgpu_destroy_context(context)
}
