package net

import "std/errors"

type IP struct { data []byte }
type IPMask []byte

func (ip IP) String() string {
    if len(ip.data) == 4 {
        return intToDec(int(ip.data[0])) + "." + intToDec(int(ip.data[1])) + "." + intToDec(int(ip.data[2])) + "." + intToDec(int(ip.data[3]))
    }
    if len(ip.data) != 16 { return "<nil>" }
    result := ""
    for i := 0; i < 8; i = i + 1 {
        if i > 0 { result += ":" }
        result += hexWord(int(ip.data[i*2])<<8 | int(ip.data[i*2+1]))
    }
    return result
}

func intToDec(value int) string {
    if value == 0 { return "0" }
    result := ""
    for value > 0 { result = string([]byte{byte(48 + value%10)}) + result; value = value / 10 }
    return result
}

func hexWord(value int) string {
    if value == 0 { return "0" }
    digits := "0123456789abcdef"
    result := ""
    for value > 0 { result = digits[value&15:value&15+1] + result; value = value >> 4 }
    return result
}

func (ip IP) Equal(other IP) bool {
    if len(ip.data) != len(other.data) { return false }
    for i := 0; i < len(ip.data); i = i + 1 { if ip.data[i] != other.data[i] { return false } }
    return true
}

type IPAddr struct { IP IP; Zone string }
func (a *IPAddr) Network() string { return "ip" }
func (a *IPAddr) String() string { if a == nil { return "<nil>" }; if a.Zone == "" { return a.IP.String() }; return a.IP.String() + "%" + a.Zone }
func (ip IP) IsMulticast() bool { return (len(ip.data) == 4 && ip.data[0] >= 224 && ip.data[0] <= 239) || (len(ip.data) == 16 && ip.data[0] == 255) }
func (ip IP) IsPrivate() bool {
    return len(ip.data) == 4 && (ip.data[0] == 10 || (ip.data[0] == 172 && ip.data[1] >= 16 && ip.data[1] <= 31) || (ip.data[0] == 192 && ip.data[1] == 168))
}
func (ip IP) IsGlobalUnicast() bool { return len(ip.data) == 4 && !ip.IsMulticast() && !ip.IsUnspecified() && !ip.IsLoopback() }

type Addr interface {
    Network() string
    String() string
}

type Conn interface {
    Read([]byte) (int, error)
    Write([]byte) (int, error)
    Close() error
}

type Listener interface {
    Accept() (Conn, error)
    Close() error
    Addr() Addr
}

type IPNet struct {
    IP IP
    Mask IPMask
}

func decimalPart(text string, start int, end int) (int, bool) {
    if start >= end { return 0, false }
    value := 0
    for i := start; i < end; i = i + 1 {
        if text[i] < byte(48) || text[i] > byte(57) { return 0, false }
        value = value*10 + int(text[i]-byte(48))
        if value > 255 { return 0, false }
    }
    return value, true
}

func parseIPv4(text string) []byte {
    result := make([]byte, 4)
    start := 0
    for part := 0; part < 4; part = part + 1 {
        end := start
        for end < len(text) && text[end] != byte(46) { end = end + 1 }
        value, ok := decimalPart(text, start, end)
        if !ok { return nil }
        result[part] = byte(value)
        if part < 3 {
            if end >= len(text) { return nil }
            start = end + 1
        } else if end != len(text) {
            return nil
        }
    }
    return result
}

func hexPart(text string, start int, end int) (int, bool) {
    if start >= end || end-start > 4 { return 0, false }
    value := 0
    for i := start; i < end; i = i + 1 {
        ch := text[i]
        digit := -1
        if ch >= byte(48) && ch <= byte(57) { digit = int(ch-byte(48)) }
        if ch >= byte(65) && ch <= byte(70) { digit = int(ch-byte(65)) + 10 }
        if ch >= byte(97) && ch <= byte(102) { digit = int(ch-byte(97)) + 10 }
        if digit < 0 { return 0, false }
        value = value*16 + digit
    }
    return value, true
}

func parseIPv6(text string) []byte {
    if len(text) == 0 { return nil }
    result := make([]byte, 16)
    words := make([]int, 8)
    wordCount := 0
    gap := -1
    i := 0
    for i < len(text) {
        if text[i] == byte(58) {
            if i+1 >= len(text) || text[i+1] != byte(58) || gap >= 0 { return nil }
            gap = wordCount
            i += 2
            if i == len(text) { break }
            continue
        }
        start := i
        for i < len(text) && text[i] != byte(58) { i = i + 1 }
        part := text[start:i]
        if stringsHasDot(part) {
            v4 := parseIPv4(part)
            if v4 == nil || wordCount > 6 { return nil }
            words[wordCount] = int(v4[0])<<8 | int(v4[1]); wordCount++
            words[wordCount] = int(v4[2])<<8 | int(v4[3]); wordCount++
        } else {
            value, ok := hexPart(text, start, i)
            if !ok || wordCount >= 8 { return nil }
            words[wordCount] = value
            wordCount++
        }
        if i < len(text) {
            if text[i] != byte(58) { return nil }
            if i+1 < len(text) && text[i+1] == byte(58) {
                if gap >= 0 { return nil }
                gap = wordCount
                i += 2
                if i == len(text) { break }
            } else {
                i = i + 1
            }
        }
    }
    if gap < 0 && wordCount != 8 { return nil }
    if gap >= 0 {
        missing := 8 - wordCount
        for j := wordCount - 1; j >= gap; j = j - 1 { words[j+missing] = words[j] }
        for j := gap; j < gap+missing; j = j + 1 { words[j] = 0 }
    }
    for j := 0; j < 8; j = j + 1 {
        result[j*2] = byte(words[j] >> 8)
        result[j*2+1] = byte(words[j])
    }
    return result
}

func stringsHasDot(text string) bool {
    for i := 0; i < len(text); i = i + 1 { if text[i] == byte(46) { return true } }
    return false
}

func SplitHostPort(address string) (string, string, error) {
    if len(address) == 0 { return "", "", errors.New("missing address") }
    if address[0] == byte(91) {
        close := -1
        for i := 1; i < len(address); i = i + 1 { if address[i] == byte(93) { close = i; break } }
        if close < 0 || close+1 >= len(address) || address[close+1] != byte(58) {
            return "", "", errors.New("missing port in address")
        }
        return address[1:close], address[close+2:], nil
    }
    colon := -1
    for i := 0; i < len(address); i = i + 1 { if address[i] == byte(58) { colon = i } }
    if colon < 0 { return "", "", errors.New("missing port in address") }
    if colon == 0 || colon+1 >= len(address) { return "", "", errors.New("missing host or port") }
    for i := 0; i < colon; i = i + 1 { if address[i] == byte(58) { return "", "", errors.New("too many colons in address") } }
    return address[:colon], address[colon+1:], nil
}

func JoinHostPort(host string, port string) string {
    if stringsHasColon(host) { return "[" + host + "]:" + port }
    return host + ":" + port
}

func stringsHasColon(text string) bool {
    for i := 0; i < len(text); i = i + 1 { if text[i] == byte(58) { return true } }
    return false
}

func ParseIP(address string) IP {
    var data []byte
    if stringsHasColon(address) { data = parseIPv6(address) } else { data = parseIPv4(address) }
    if data == nil { return IP{} }
    return IP{data: data}
}

func InterfaceAddrs() ([]Addr, error) { return nil, errors.New("network interface enumeration is not supported") }
func Listen(network string, address string) (Listener, error) { return nil, errors.New("network listeners are not supported on the Windows WinHTTP backend") }

func (ip IP) To4() IP {
    if len(ip.data) == 4 { return ip }
    if len(ip.data) != 16 { return IP{} }
    for i := 0; i < 10; i = i + 1 { if ip.data[i] != 0 { return IP{} } }
    if ip.data[10] != byte(255) || ip.data[11] != byte(255) { return IP{} }
    return IP{data: ip.data[12:16]}
}

func (ip IP) IsUnspecified() bool {
    if len(ip.data) != 4 && len(ip.data) != 16 { return false }
    for i := 0; i < len(ip.data); i = i + 1 { if ip.data[i] != 0 { return false } }
    return true
}

func (ip IP) IsLinkLocalUnicast() bool {
    if len(ip.data) == 4 { return ip.data[0] == 169 && ip.data[1] == 254 }
    return len(ip.data) == 16 && ip.data[0] == 0xfe && (ip.data[1]&byte(0xc0)) == byte(0x80)
}

func (ip IP) IsLoopback() bool {
    if len(ip.data) == 4 { return ip.data[0] == 127 }
    if len(ip.data) == 16 {
        for i := 0; i < 15; i = i + 1 { if ip.data[i] != 0 { return false } }
        return ip.data[15] == 1
    }
    return false
}
