// Package url provides the URL representation used by the compiler tools.
package url

import (
	"std/errors"
	"std/strings"
)

type URL struct {
	Scheme string
	Opaque string
	User string
	Host string
	Path string
	RawPath string
	ForceQuery bool
	RawQuery string
	Fragment string
}

func Parse(text string) (*URL, error) {
	u := &URL{}
	if i := strings.Index(text, "://"); i >= 0 {
		u.Scheme = text[:i]
		text = text[i+3:]
		if i = strings.Index(text, "/"); i >= 0 {
			u.Host, text = text[:i], text[i:]
		} else {
			u.Host, text = text, ""
		}
	}
	if i := strings.Index(text, "#"); i >= 0 {
		u.Fragment, text = text[i+1:], text[:i]
	}
	if i := strings.Index(text, "?"); i >= 0 {
		u.RawQuery, text = text[i+1:], text[:i]
	}
	u.Path = text
	return u, nil
}

func (u *URL) String() string {
	result := ""
	if u.Scheme != "" { result += u.Scheme + "://" }
	result += u.Host + escapeURLPath(u.Path)
	if u.ForceQuery || u.RawQuery != "" { result += "?" + u.RawQuery }
	if u.Fragment != "" { result += "#" + u.Fragment }
	return result
}

const urlHex = "0123456789ABCDEF"

func isURLUnreserved(ch byte) bool {
	return (ch >= byte(48) && ch <= byte(57)) ||
		(ch >= byte(65) && ch <= byte(90)) ||
		(ch >= byte(97) && ch <= byte(122)) ||
		ch == byte(45) || ch == byte(46) || ch == byte(95) || ch == byte(126)
}

// escapeURLBytes percent-encodes the UTF-8 bytes of value.  Iterating over
// bytes is intentional: URL escaping is defined on the UTF-8 octets, not on
// Unicode code points or UTF-16 code units.
func escapeURLBytes(value string, preserveSlash bool, spaceAsPlus bool) string {
	result := ""
	for i := 0; i < len(value); i = i + 1 {
		ch := value[i]
		if isURLUnreserved(ch) || (preserveSlash && ch == byte(47)) {
			result += value[i:i+1]
		} else if spaceAsPlus && ch == byte(32) {
			result += "+"
		} else {
			result += "%"
			result += string([]byte{urlHex[int(ch>>4)]})
			result += string([]byte{urlHex[int(ch&15)]})
		}
	}
	return result
}

// escapeURLPath is used by URL.String.  Slashes delimit path segments and
// therefore remain separators, while multibyte UTF-8 bytes are escaped.
func escapeURLPath(value string) string {
	return escapeURLBytes(value, true, false)
}

// PathEscape percent-encodes a path segment.  In particular, '/' is escaped
// because it is data inside a single segment.
func PathEscape(value string) string {
	return escapeURLBytes(value, false, false)
}

// QueryEscape percent-encodes a query component using '+' for spaces.
func QueryEscape(value string) string {
	return escapeURLBytes(value, false, true)
}

func (u *URL) ResolveReference(ref *URL) *URL {
	if ref.Scheme != "" { return ref }
	result := *ref
	result.Scheme = u.Scheme
	result.Host = u.Host
	if !strings.HasPrefix(result.Path, "/") {
		base := u.Path
		if i := strings.LastIndex(base, "/"); i >= 0 { base = base[:i+1] } else { base = "" }
		result.Path = base + result.Path
	}
	return &result
}

func hexValue(ch byte) int {
    if ch >= byte(48) && ch <= byte(57) { return int(ch - byte(48)) }
    if ch >= byte(65) && ch <= byte(70) { return int(ch - byte(65) + byte(10)) }
    if ch >= byte(97) && ch <= byte(102) { return int(ch - byte(97) + byte(10)) }
    return -1
}

func PathUnescape(value string) (string, error) {
    result := ""
    var noErr error = nil
    for i := 0; i < len(value); i = i + 1 {
        if value[i] == byte(37) {
            if i+2 >= len(value) { return "", errors.New("invalid URL escape") }
            hi := hexValue(value[i+1])
            lo := hexValue(value[i+2])
            if hi < 0 || lo < 0 { return "", errors.New("invalid URL escape") }
            result = result + string([]byte{byte((hi<<4)|lo)})
            i += 2
        } else if value[i] == byte(43) {
            result = result + " "
        } else {
            result = result + value[i:i+1]
        }
    }
    return result, noErr
}

// QueryUnescape decodes a query component.  Percent escapes are decoded as
// raw UTF-8 bytes and '+' is interpreted as a space.
func QueryUnescape(value string) (string, error) {
	return PathUnescape(value)
}
