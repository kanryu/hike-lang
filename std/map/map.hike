package map

func malloc(size int) *byte
func free(ptr *byte) void
func calloc(num int, size int) *byte

type MapBehavior[K, V] interface {
    Set(key K, val V) void
    Get(key K) (V, bool)
    Delete(key K) void
    Len() int
    InitIterator(buf *byte) int
    Next(buf *byte) (*K, *V, bool)
}

type Entry[K, V] struct {
    hash int
    key  K
    val  V
    next *Entry[K, V]
}

type Map[K, V] struct {
    buckets **Entry[K, V]
    numBuckets int
    length     int
}

type MapIterator[K, V] struct {
    bucketIdx int
    current   *Entry[K, V]
}

func InitIterator[K, V](m *Map[K, V], buf *byte) int {
    if buf == nil {
        return 16
    }
    var it *MapIterator[K, V] = (*MapIterator[K, V])(buf)
    it.bucketIdx = 0
    it.current = nil
    return 0
}

func Next[K, V](m *Map[K, V], buf *byte) (*K, *V, bool) {
    if m.buckets == nil || m.length == 0 {
        return nil, nil, false
    }

    var it *MapIterator[K, V] = (*MapIterator[K, V])(buf)

    if it.current != nil && it.current.next != nil {
        it.current = it.current.next
        return &it.current.key, &it.current.val, true
    }

    if it.current != nil {
        it.bucketIdx = it.bucketIdx + 1
        it.current = nil
    }

    for it.bucketIdx < m.numBuckets {
        entry := m.buckets[it.bucketIdx]
        if entry != nil {
            it.current = entry
            return &entry.key, &entry.val, true
        }
        it.bucketIdx = it.bucketIdx + 1
    }

    return nil, nil, false
}

func hashKey[K](key K) int {
    return int(key)
}

func keyEqual[K](a K, b K) bool {
    return a == b
}

func New[K, V](initialCap int) Map[K, V] {
    if initialCap <= 0 {
        initialCap = 16
    }
    var m Map[K, V]
    m.numBuckets = initialCap
    m.length = 0
    m.buckets = calloc(initialCap, 8)
    return m
}

func Set[K, V](m *Map[K, V], key K, val V) {
    if m.buckets == nil {
        *m = New[K, V](16)
    }

    if m.length * 4 >= m.numBuckets * 3 {
        grow[K, V](m)
    }

    h := hashKey[K](key)
    idx := h % m.numBuckets
    if idx < 0 {
        idx = -idx
    }

    cur := m.buckets[idx]
    for cur != nil {
        if cur.hash == h && keyEqual[K](cur.key, key) {
            cur.val = val
            return
        }
        cur = cur.next
    }

    var newEntry *Entry[K, V] = malloc(32)
    newEntry.hash = h
    newEntry.key = key
    newEntry.val = val
    newEntry.next = m.buckets[idx]
    m.buckets[idx] = newEntry
    m.length = m.length + 1
}

func Get[K, V](m *Map[K, V], key K) (V, bool) {
    if m.buckets == nil || m.length == 0 {
        var zero V
        return zero, false
    }

    h := hashKey[K](key)
    idx := h % m.numBuckets
    if idx < 0 {
        idx = -idx
    }

    cur := m.buckets[idx]
    for cur != nil {
        if cur.hash == h && keyEqual[K](cur.key, key) {
            return cur.val, true
        }
        cur = cur.next
    }

    var zero V
    return zero, false
}

func Delete[K, V](m *Map[K, V], key K) {
    if m.buckets == nil || m.length == 0 {
        return
    }

    h := hashKey[K](key)
    idx := h % m.numBuckets
    if idx < 0 {
        idx = -idx
    }

    var prev *Entry[K, V] = nil
    cur := m.buckets[idx]

    for cur != nil {
        if cur.hash == h && keyEqual[K](cur.key, key) {
            if prev == nil {
                m.buckets[idx] = cur.next
            } else {
                prev.next = cur.next
            }
            free(cur)
            m.length = m.length - 1
            return
        }
        prev = cur
        cur = cur.next
    }
}

func Len[K, V](m *Map[K, V]) int {
    return m.length
}

func grow[K, V](m *Map[K, V]) {
    oldBuckets := m.buckets
    oldNum := m.numBuckets
    newNum := oldNum * 2

    m.buckets = calloc(newNum, 8)
    m.numBuckets = newNum

    for i := 0; i < oldNum; i++ {
        cur := oldBuckets[i]
        for cur != nil {
            nxt := cur.next
            idx := cur.hash % newNum
            if idx < 0 {
                idx = -idx
            }
            cur.next = m.buckets[idx]
            m.buckets[idx] = cur
            cur = nxt
        }
    }
    free(oldBuckets)
}