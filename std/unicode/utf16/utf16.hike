// Package utf16 converts between Hike UTF-8 strings and UTF-16 code units.
//
// string values remain UTF-8.  Encode and Decode use the endian-neutral
// UTF-16 representation ([]uint16); EncodeLE/EncodeBE and DecodeLE/DecodeBE
// are the byte-oriented APIs for external protocols and operating-system
// interfaces.
package utf16

const RuneError rune = 0xFFFD
const MaxRune rune = 0x10FFFF
const ReplacementChar uint16 = 0xFFFD

const HighSurrogateMin uint16 = 0xD800
const HighSurrogateMax uint16 = 0xDBFF
const LowSurrogateMin uint16 = 0xDC00
const LowSurrogateMax uint16 = 0xDFFF

func IsSurrogate(r uint16) bool {
	return r >= HighSurrogateMin && r <= LowSurrogateMax
}

func IsHighSurrogate(r uint16) bool {
	return r >= HighSurrogateMin && r <= HighSurrogateMax
}

func IsLowSurrogate(r uint16) bool {
	return r >= LowSurrogateMin && r <= LowSurrogateMax
}

// Encode converts a UTF-8 string into endian-neutral UTF-16 code units.
// Non-BMP runes are represented by a high/low surrogate pair.
func Encode(s string) []uint16 {
	result := make([]uint16, 0, len(s))
	for _, r := range s {
		if r < 0 || r > MaxRune || (r >= 0xD800 && r <= 0xDFFF) {
			r = RuneError
		}
		if r <= 0xFFFF {
			result = append(result, uint16(r))
			continue
		}
		x := uint32(r) - 0x10000
		result = append(result, uint16(0xD800+(x>>10)), uint16(0xDC00+(x&0x3FF)))
	}
	return result
}

// Decode converts endian-neutral UTF-16 code units into a UTF-8 string.
// Unpaired surrogates are replaced with U+FFFD.
func Decode(units []uint16) string {
	result := ""
	for i := 0; i < len(units); i = i + 1 {
		u := units[i]
		if IsHighSurrogate(u) {
			if i+1 < len(units) && IsLowSurrogate(units[i+1]) {
				lo := units[i+1]
				cp := rune(0x10000 + ((uint32(u)-0xD800)<<10) + (uint32(lo) - 0xDC00))
				result += string(cp)
				i = i + 1
			} else {
				result += string(RuneError)
			}
		} else if IsLowSurrogate(u) {
			result += string(RuneError)
		} else {
			result += string(rune(u))
		}
	}
	return result
}

// EncodeLE serializes a UTF-8 string as UTF-16LE without a BOM.
func EncodeLE(s string) []byte {
	units := Encode(s)
	result := make([]byte, len(units)*2)
	for i := 0; i < len(units); i = i + 1 {
		u := units[i]
		result[i*2] = byte(u)
		result[i*2+1] = byte(u >> 8)
	}
	return result
}

// EncodeBE serializes a UTF-8 string as UTF-16BE without a BOM.
func EncodeBE(s string) []byte {
	units := Encode(s)
	result := make([]byte, len(units)*2)
	for i := 0; i < len(units); i = i + 1 {
		u := units[i]
		result[i*2] = byte(u >> 8)
		result[i*2+1] = byte(u)
	}
	return result
}

// DecodeLE deserializes UTF-16LE bytes without requiring or producing a BOM.
// An odd trailing byte is ignored.
func DecodeLE(data []byte) string {
	units := make([]uint16, len(data)/2)
	for i := 0; i < len(units); i = i + 1 {
		units[i] = uint16(data[i*2]) | uint16(data[i*2+1])<<8
	}
	return Decode(units)
}

// DecodeBE deserializes UTF-16BE bytes without requiring or producing a BOM.
// An odd trailing byte is ignored.
func DecodeBE(data []byte) string {
	units := make([]uint16, len(data)/2)
	for i := 0; i < len(units); i = i + 1 {
		units[i] = uint16(data[i*2])<<8 | uint16(data[i*2+1])
	}
	return Decode(units)
}
