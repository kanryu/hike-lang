package fmt

// 非公開のC標準関数宣言 (C ABI 可変長)
func printf(format string, ...) int

// 外部公開する Printf 関数
func Printf(format string, ...) int {
	return printf(format, ...)
}

// PrintStr: 文字列を出力します
func PrintStr(s *byte) {
	if s == nil {
		return
	}
	printf("%s", s)
}

// PrintInt: 整数を出力します
func PrintInt(v int) {
	printf("%d", v)
}

// PrintFloat: 浮動小数点数を出力します
func PrintFloat(f float64) {
	printf("%f", f)
}

// PrintLn: 改行付きで文字列を出力します (*byte 版)
func PrintLn(s *byte) {
	if s == nil {
		printf("\n")
		return
	}
	printf("%s\n", s)
}

// Println: 改行付き文字列出力 (string 版)
func Println(s string) {
	printf("%s\n", s)
}

// ErrorLn: コンパイルエラー表示用プレフィックス付き出力
func ErrorLn(msg *byte) {
	printf("[ERROR] %s\n", msg)
}