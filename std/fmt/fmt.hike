package fmt

func printf(format *byte, ...) int

func PrintStr(s *byte) {
	if s == nil {
		return
	}
	printf("%s", s)
}

func PrintInt(v int) {
	printf("%d", v)
}

func PrintFloat(f float64) {
	printf("%f", f)
}

func PrintLn(s *byte) {
	if s == nil {
		printf("\n")
		return
	}
	printf("%s\n", s)
}

func ErrorLn(msg *byte) {
	printf("[ERROR] %s\n", msg)
}