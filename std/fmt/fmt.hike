package fmt

import "std/fmt/sprintf"
import "std/errors"
import "std/strings"

// 画面出力用のC標準関数宣言 (ネイティブ環境用)
extern func printf(format string, ...) int

// Sprintf は std/fmt/sprintf に定義された純粋実装を委譲呼び出しします
func Sprintf(format string, args ...any) string {
	return sprintf.Sprintf(format, args...)
}

func Fprintf(w *strings.Builder, format string, args ...any) int {
	s := Sprintf(format, args...)
	if w != nil {
		w.WriteString(s)
	}
	return len(s)
}

// Fprint and Fprintln are used by compiler diagnostics. The browser stub
// discards output when the destination is nil, while retaining the same
// callable surface as Go's fmt package.
func Fprint(w *strings.Builder, args ...any) int {
	if w == nil {
		return 0
	}
	for i := 0; i < len(args); i++ {
		if s, ok := args[i].(string); ok {
			w.WriteString(s)
		}
	}
	return w.Len()
}

func Fprintln(w *strings.Builder, s string) int {
	if w == nil {
		return 0
	}
	w.WriteString(s + "\n")
	return w.Len()
}

// Errorf mirrors the Go formatter used by the compiler packages.  Returning
// the Hike error interface is important when Go-Hike sources are compiled:
// callers commonly return fmt.Errorf directly from an error-bearing function.
func Errorf(format string, args ...any) error {
	return errors.New(Sprintf(format, args...))
}

// Printf は Sprintf で文字列を組み立てた後に標準出力へ出力します
func Printf(format string, args ...any) int {
	s := Sprintf(format, args...)
	printf("%s", s)
	return len(s)
}

// Println は改行付きで文字列を出力します
func Println(s string) {
	printf("%s\n", s)
}

// PrintStr はバイトポインタ文字列を出力します
func PrintStr(s *byte) {
	if s == nil {
		return
	}
	printf("%s", s)
}

// PrintInt は整数を出力します
func PrintInt(v int) {
	printf("%d", v)
}

// PrintFloat は浮動小数点数を出力します
func PrintFloat(f float64) {
	// The browser WABT bootstrap exposes printf with a pointer-only ABI.
	// Keep this helper available to Go-Hike sources without generating an
	// incompatible float variadic call in the bootstrap module.
	_ = f
}

// PrintLn は改行付きでバイトポインタ文字列を出力します
func PrintLn(s *byte) {
	if s == nil {
		printf("\n")
		return
	}
	printf("%s\n", s)
}

// ErrorLn はエラープレフィックス付きで出力します
func ErrorLn(msg *byte) {
	printf("[ERROR] %s\n", msg)
}
