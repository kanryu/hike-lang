package fmt

import "std/fmt/sprintf"
import "std/errors"
import "std/strings"
import "std/strconv"

type Stringer interface {
	String() string
}

// Native compiler diagnostics may reach fmt before their destination has
// been initialized. LLVM targets provide this low-level stderr sink in the
// built-in runtime.
extern func __hike_stderr_write(data cstring, length int32)

// StringWriter is the writer-facing part of Go's io.Writer-compatible API.
// Both strings.Builder and os.File implement it without requiring fmt to
// depend on either concrete package.
func writeString(w any, s string) (int, error) {
	switch writer := w.(type) {
	case *strings.Builder:
		if writer == nil {
			return 0, nil
		}
		return writer.WriteString(s)
	default:
		__hike_stderr_write(cstring(s), int32(len(s)))
		return len(s), nil
	}
}

// 画面出力用のC標準関数宣言 (ネイティブ環境用)
extern func printf(format cstring, ...) int
extern func puts(s cstring) int

// Sprintf は std/fmt/sprintf に定義された純粋実装を委譲呼び出しします
func Sprintf(format string, args ...any) string {
	return sprintf.Sprintf(format, args...)
}

func Sprint(args ...any) string {
	return sprintf.Sprintf("%v", args...)
}

func Sscan(text string, args ...any) (int, error) { return 0, nil }

func Fprintf(w any, format string, args ...any) int {
	s := Sprintf(format, args...)
	writeString(w, s)
	return len(s)
}

// Fprint and Fprintln are used by compiler diagnostics. The browser stub
// discards output when the destination is nil, while retaining the same
// callable surface as Go's fmt package.
func Fprint(w any, args ...any) int {
	total := 0
	for i := 0; i < len(args); i++ {
		if s, ok := args[i].(string); ok {
			writeString(w, s)
			total = total + len(s)
		}
	}
	return total
}

func Fprintln(w any, s string) int {
	text := s + "\n"
	writeString(w, text)
	return len(text)
}

// Errorf mirrors the Go formatter used by the compiler packages.  Returning
// the Hike error interface is important when Go-Hike sources are compiled:
// callers commonly return fmt.Errorf directly from an error-bearing function.
func Errorf(format string, args ...any) error {
	return errors.New(Sprintf(format, args...))
}

// Printf は Sprintf で文字列を組み立てた後に標準出力へ出力します
func Printf(format string, args ...any) int {
	s := Sprintf(format, args...)
	printf(cstring("%s"), cstring(s))
	return len(s)
}

// Println は改行付きで文字列を出力します
func Println(s string) {
	puts(cstring(s))
}

// PrintStr はバイトポインタ文字列を出力します
func PrintStr(s cstring) {
	if s == nil {
		return
	}
	printf(cstring("%s"), s)
}

// PrintInt は整数を出力します
func PrintInt(v int) {
	printf(cstring("%d"), v)
}

// PrintFloat は浮動小数点数を出力します
func PrintFloat(f float64) {
	s := strconv.FormatFloat(f, byte(103), -1, 64)
	printf(cstring("%s"), cstring(s))
}

// PrintLn は改行付きでバイトポインタ文字列を出力します
func PrintLn(s cstring) {
	if s == nil {
	printf(cstring("\n"))
		return
	}
	printf(cstring("%s\n"), s)
}

// ErrorLn はエラープレフィックス付きで出力します
func ErrorLn(msg cstring) {
	printf(cstring("[ERROR] %s\n"), cstring(msg))
}
