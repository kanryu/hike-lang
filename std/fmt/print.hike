package fmt

func printf(format *byte, ...) int

// PrintStr: 文字列を出力します
func PrintStr(s *byte) {
	if s == nil {
		return
	}
	printf("%s", s)
}

// PrintInt: 整数を出力します
func PrintInt(v int) {
	printf("%d", v)
}

// PrintLn: 改行付きで文字列を出力します
func PrintLn(s *byte) {
	if s == nil {
		printf("\n")
		return
	}
	printf("%s\n", s)
}

// ErrorLn: コンパイルエラー表示用プレフィックス付き出力
func ErrorLn(msg *byte) {
	printf("[ERROR] %s\n", msg)
}