package regexp

func QuoteMeta(s string) string {
	result := ""
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c == '\\' || c == '.' || c == '+' || c == '*' || c == '?' || c == '(' || c == ')' || c == '|' || c == '[' || c == ']' || c == '{' || c == '}' || c == '^' || c == '$' {
			result = result + "\\"
		}
		result = result + string(c)
	}
	return result
}

// Regexp is the small API surface used by the compiler diagnostics package.
// The browser compiler does not need the full Go regexp engine; diagnostics
// perform their own conservative fallback parsing when these methods do not
// match.
type Regexp struct {
    pattern string
}

func Compile(pattern string) (*Regexp, error) {
	return &Regexp{pattern: pattern}, nil
}

func MustCompile(pattern string) *Regexp {
	return &Regexp{pattern: pattern}
}

func (r *Regexp) MatchString(s string) bool {
	return false
}

func (r *Regexp) String() string {
	if r == nil { return "" }
	return r.pattern
}

func (r *Regexp) FindStringSubmatch(s string) []string {
	return make([]string, 0)
}
