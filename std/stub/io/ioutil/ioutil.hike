package ioutil

import "std/io"

func ReadAll(reader io.Reader) ([]byte, error) {
	result := make([]byte, 0)
	buffer := make([]byte, 4096)
	for {
		n, err := reader.Read(buffer)
		if n > 0 {
			result = append(result, buffer[0:n]...)
		}
		if err != nil || n == 0 {
			break
		}
	}
	return result, nil
}
