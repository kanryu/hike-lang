package exec

type Cmd struct {
    Path string
    Args []string
    Stdout *byte
    Stderr *byte
}

type ExitError struct {
    Code int
}

func (e *ExitError) ExitCode() int {
    return e.Code
}

func Command(name string, args ...string) *Cmd {
    return &Cmd{Path: name, Args: args}
}

func (c *Cmd) Run() error { return nil }
