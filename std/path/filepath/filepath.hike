package filepath

import "std/strings"
import "std/os"
import "std/errors"

func Abs(p string) (string, error) {
	if IsAbs(p) {
		return Clean(p), nil
	}
	cwd, err := os.Getwd()
	if err != nil {
		return "", err
	}
	return Clean(Join(cwd, p)), nil
}
func IsAbs(p string) bool {
	if len(p) == 0 { return false }
	if p[0] == '/' || p[0] == '\\' { return true }
	return len(p) >= 3 && p[1] == ':' && (p[2] == '/' || p[2] == '\\')
}
func ToSlash(p string) string { return strings.ReplaceAll(p, "\\", "/") }
func FromSlash(p string) string { return p }
func Rel(base string, target string) (string, error) {
	base = Clean(base)
	target = Clean(target)
	baseAbs := IsAbs(base)
	if baseAbs != IsAbs(target) { return "", errors.New("Rel: mismatched path types") }
	baseParts := strings.Split(strings.TrimPrefix(base, "/"), "/")
	targetParts := strings.Split(strings.TrimPrefix(target, "/"), "/")
	i := 0
	for i < len(baseParts) && i < len(targetParts) && baseParts[i] == targetParts[i] {
		i = i + 1
	}
	parts := make([]string, 0, len(baseParts)+len(targetParts))
	for j := i; j < len(baseParts); j = j + 1 {
		if baseParts[j] != "" && baseParts[j] != "." { parts = append(parts, "..") }
	}
	for j := i; j < len(targetParts); j = j + 1 {
		if targetParts[j] != "" && targetParts[j] != "." { parts = append(parts, targetParts[j]) }
	}
	if len(parts) == 0 { return ".", nil }
	return strings.Join(parts, "/"), nil
}
func Clean(p string) string {
	if p == "" { return "." }
	volume := ""
	abs := IsAbs(p)
	if len(p) >= 2 && p[1] == ':' {
		volume = p[0:2]
		p = p[2:]
	}
	parts := strings.Split(ToSlash(p), "/")
	stack := make([]string, 0, len(parts))
	for i := 0; i < len(parts); i = i + 1 {
		part := parts[i]
		if part == "" || part == "." { continue }
		if part == ".." {
			if len(stack) > 0 && stack[len(stack)-1] != ".." {
				stack = stack[:len(stack)-1]
			} else if !abs { stack = append(stack, part) }
			continue
		}
		stack = append(stack, part)
	}
	result := strings.Join(stack, "/")
	if abs { result = "/" + result }
	if volume != "" {
		result = volume + result
		if result == volume { result = volume + "/" }
	}
	if result == "" { if abs { return "/" }; return "." }
	return result
}
func Base(p string) string {
	parts := strings.Split(ToSlash(p), "/")
	if len(parts) == 0 { return "" }
	return parts[len(parts)-1]
}
func Dir(p string) string {
	normalized := ToSlash(p)
	idx := strings.LastIndex(normalized, "/")
	if idx < 0 { return "." }
	return normalized[0:idx]
}
func Ext(p string) string {
	name := Base(p)
	idx := strings.LastIndex(name, ".")
	if idx < 0 { return "" }
	return name[idx:len(name)]
}
func Join(parts ...string) string {
	joined := ""
	for i := 0; i < len(parts); i++ {
		part := parts[i]
		if part == "" { continue }
		if joined == "" {
			joined = part
			continue
		}
		joined = ToSlash(joined) + "/" + part
	}
	return joined
}

// Glob returns the paths in the directory portion of pattern whose names
// match the final wildcard component. Filesystem errors are treated like the
// standard library's filepath.Glob: an unreadable directory produces no
// matches, while the pattern itself remains valid.
func Glob(pattern string) ([]string, error) {
	dir := Dir(pattern)
	name := Base(pattern)
	readDir := dir
	if readDir == "." { readDir = "" }
	entries, err := os.ReadDir(readDir)
	if err != nil { return []string{}, nil }
	matches := make([]string, 0)
	for i := 0; i < len(entries); i = i + 1 {
		entryName := entries[i].Name()
		if filepathMatch(name, entryName) {
			if dir == "." { matches = append(matches, entryName) } else { matches = append(matches, Join(dir, entryName)) }
		}
	}
	return matches, nil
}

func filepathMatch(pattern string, value string) bool {
	if len(pattern) == 0 { return len(value) == 0 }
	if pattern[0] == '*' {
		for i := 0; i <= len(value); i = i + 1 {
			if filepathMatch(pattern[1:len(pattern)], value[i:len(value)]) { return true }
		}
		return false
	}
	if len(value) == 0 { return false }
	if pattern[0] != '?' && pattern[0] != value[0] { return false }
	return filepathMatch(pattern[1:len(pattern)], value[1:len(value)])
}
