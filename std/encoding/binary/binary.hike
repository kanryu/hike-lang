package binary

// ByteOrder is the small byte-order interface used by the Go standard
// library. The implementation below intentionally covers the operations used
// by the current Go-Hike compatibility sources.
type ByteOrder interface {
    Uint32([]byte) uint32
    PutUint32([]byte, uint32)
}

type littleEndian struct {}

var LittleEndian littleEndian

func (littleEndian) Uint32(b []byte) uint32 {
    return uint32(b[0]) | uint32(b[1]) << 8 | uint32(b[2]) << 16 | uint32(b[3]) << 24
}

func (littleEndian) PutUint32(b []byte, v uint32) {
    b[0] = byte(v)
    b[1] = byte(v >> 8)
    b[2] = byte(v >> 16)
    b[3] = byte(v >> 24)
}
