package japanese

import "std/encoding"

type EncodingError struct {
	msg string
}

func (e *EncodingError) Error() string {
	return e.msg
}

func newError(msg string) error {
	return &EncodingError{msg: msg}
}

type ShiftJISEncoding struct {
}

func NewShiftJIS() *ShiftJISEncoding {
	return &ShiftJISEncoding{}
}

func (s *ShiftJISEncoding) Name() string {
	return "Shift_JIS"
}

// -----------------------------------------------------------------------------
// デコード処理: Shift_JIS (cstring) -> UTF-8 (string)
// -----------------------------------------------------------------------------

func (s *ShiftJISEncoding) Decode(src cstring, length int = -1) (string, error, int) {
	if src == nil {
		return "", nil, 0
	}

	srcLen := length
	if srcLen < 0 {
		srcLen = len(src)
	}

	out := make([]byte, 0, srcLen * 2 + 1)
	consumed := 0
	i := 0

	for i < srcLen {
		b1 := int(src[i])

		if b1 == 0 {
			if length < 0 {
				break
			}
			out = append(out, byte(0))
			i++
			consumed++
			continue
		}

		// 1バイト ASCII
		if b1 <= 0x7F {
			out = append(out, byte(b1))
			i++
			consumed++
			continue
		}

		// 半角カナ (0xA1 - 0xDF)
		if b1 >= 0xA1 && b1 <= 0xDF {
			if b1 <= 0xBF {
				out = append(out, byte(0xEF), byte(0xBD), byte(b1))
			} else {
				out = append(out, byte(0xEF), byte(0xBE), byte(b1 - 0x40))
			}
			i++
			consumed++
			continue
		}

		// 2バイト文字の第1バイト (0x81-0x9F, 0xE0-0xFC)
		if (b1 >= 0x81 && b1 <= 0x9F) || (b1 >= 0xE0 && b1 <= 0xFC) {
			if i + 1 >= srcLen {
				return string(out), newError("incomplete Shift_JIS sequence at end of input"), consumed
			}

			b2 := int(src[i + 1])
			if !((b2 >= 0x40 && b2 <= 0x7E) || (b2 >= 0x80 && b2 <= 0xFC)) {
				return string(out), newError("invalid Shift_JIS trail byte"), consumed
			}

			cp, ok := decodeTwoByte(b1, b2)
			if !ok {
				out = append(out, byte(0xEF), byte(0xBF), byte(0xBD))
			} else {
				appendUTF8(&out, cp)
			}

			i += 2
			consumed += 2
			continue
		}

		return string(out), newError("illegal Shift_JIS lead byte"), consumed
	}

	return string(out), nil, consumed
}

// -----------------------------------------------------------------------------
// エンコード処理: UTF-8 (string) -> Shift_JIS (cstring)
// -----------------------------------------------------------------------------

func (s *ShiftJISEncoding) Encode(src string, length int = -1) (cstring, error, int) {
	srcLen := length
	if srcLen < 0 {
		srcLen = len(src)
	}

	out := make([]byte, 0, srcLen + 1)
	i := 0
	produced := 0

	for i < srcLen {
		b1 := int(byte(src[i]))

		if b1 == 0 {
			if length < 0 {
				break
			}
			out = append(out, byte(0))
			i++
			produced++
			continue
		}

		if b1 <= 0x7F {
			out = append(out, byte(b1))
			i++
			produced++
			continue
		}

		var cp uint = 0
		var charLen int = 0

		if (b1 & 0xE0) == 0xC0 && i + 1 < srcLen {
			b2 := int(byte(src[i + 1]))
			cp = (uint(b1 & 0x1F) << 6) | uint(b2 & 0x3F)
			charLen = 2
		} else if (b1 & 0xF0) == 0xE0 && i + 2 < srcLen {
			b2 := int(byte(src[i + 1]))
			b3 := int(byte(src[i + 2]))
			cp = (uint(b1 & 0x0F) << 12) | (uint(b2 & 0x3F) << 6) | uint(b3 & 0x3F)
			charLen = 3
		} else if (b1 & 0xF8) == 0xF0 && i + 3 < srcLen {
			b2 := int(byte(src[i + 1]))
			b3 := int(byte(src[i + 2]))
			b4 := int(byte(src[i + 3]))
			cp = (uint(b1 & 0x07) << 18) | (uint(b2 & 0x3F) << 12) | (uint(b3 & 0x3F) << 6) | uint(b4 & 0x3F)
			charLen = 4
		} else {
			return cstring(string(out)), newError("invalid UTF-8 sequence in source string"), produced
		}

		if cp >= 0xFF61 && cp <= 0xFF9F {
			var sjisKana byte
			if cp <= 0xFF7F {
				sjisKana = byte(0xA1 + int(cp - 0xFF61))
			} else {
				sjisKana = byte(0xC0 + int(cp - 0xFF80))
			}
			out = append(out, sjisKana)
			i += charLen
			produced++
			continue
		}

		s1, s2, ok := encodeTwoByte(cp)
		if !ok {
			return cstring(string(out)), newError("character cannot be encoded to Shift_JIS"), produced
		}

		out = append(out, s1, s2)
		i += charLen
		produced += 2
	}

	out = append(out, byte(0))
	return cstring(string(out)), nil, produced
}

// -----------------------------------------------------------------------------
// 2バイト文字の相互マッピングヘルパー
// -----------------------------------------------------------------------------

func decodeTwoByte(b1 int, b2 int) (uint, bool) {
	if b1 == 0x81 && b2 == 0x40 {
		return 0x3000, true
	}

	if b1 == 0x81 {
		switch b2 {
		case 0x41: return 0x3001, true
		case 0x42: return 0x3002, true
		case 0x43: return 0xFF0C, true
		case 0x44: return 0xFF0E, true
		case 0x45: return 0x30FB, true
		case 0x46: return 0xFF1A, true
		case 0x47: return 0xFF1B, true
		case 0x48: return 0xFF1F, true
		case 0x49: return 0xFF01, true
		case 0x5B: return 0x30FC, true
		case 0x5C: return 0x2015, true
		case 0x5D: return 0x2010, true
		case 0x5E: return 0xFF0F, true
		case 0x60: return 0xFF5E, true
		case 0x69: return 0xFF08, true
		case 0x6A: return 0xFF09, true
		case 0x6B: return 0xFF3B, true
		case 0x6C: return 0xFF3D, true
		case 0x6D: return 0xFF5B, true
		case 0x6E: return 0xFF5D, true
		case 0x75: return 0x300C, true
		case 0x76: return 0x300D, true
		case 0x77: return 0x300E, true
		case 0x78: return 0x300F, true
		case 0x7B: return 0xFF0B, true
		case 0x7C: return 0xFF0D, true
		case 0x81: return 0xFF1D, true
		case 0x83: return 0xFF1C, true
		case 0x84: return 0xFF1E, true
		}
	}

	if b1 == 0x82 {
		if b2 >= 0x4F && b2 <= 0x58 {
			return 0xFF10 + uint(b2 - 0x4F), true
		}
		if b2 >= 0x60 && b2 <= 0x79 {
			return 0xFF21 + uint(b2 - 0x60), true
		}
		if b2 >= 0x81 && b2 <= 0x9A {
			return 0xFF41 + uint(b2 - 0x81), true
		}
		if b2 >= 0x9F && b2 <= 0xF1 {
			return 0x3041 + uint(b2 - 0x9F), true
		}
	}

	if b1 == 0x83 {
		if b2 >= 0x40 && b2 <= 0x7E {
			return 0x30A1 + uint(b2 - 0x40), true
		}
		if b2 >= 0x80 && b2 <= 0x96 {
			return 0x30E0 + uint(b2 - 0x80), true
		}
	}

	return decodeCommonKanji(b1, b2)
}

func encodeTwoByte(cp uint) (byte, byte, bool) {
	if cp == 0x3000 {
		return byte(0x81), byte(0x40), true
	}

	if cp >= 0xFF10 && cp <= 0xFF19 {
		return byte(0x82), byte(0x4F + int(cp - 0xFF10)), true
	}
	if cp >= 0xFF21 && cp <= 0xFF3A {
		return byte(0x82), byte(0x60 + int(cp - 0xFF21)), true
	}
	if cp >= 0xFF41 && cp <= 0xFF5A {
		return byte(0x82), byte(0x81 + int(cp - 0xFF41)), true
	}
	if cp >= 0x3041 && cp <= 0x3093 {
		return byte(0x82), byte(0x9F + int(cp - 0x3041)), true
	}
	if cp >= 0x30A1 && cp <= 0x30DF {
		return byte(0x83), byte(0x40 + int(cp - 0x30A1)), true
	}
	if cp >= 0x30E0 && cp <= 0x30F6 {
		return byte(0x83), byte(0x80 + int(cp - 0x30E0)), true
	}

	switch cp {
	case 0x3001: return byte(0x81), byte(0x41), true
	case 0x3002: return byte(0x81), byte(0x42), true
	case 0xFF0C: return byte(0x81), byte(0x43), true
	case 0xFF0E: return byte(0x81), byte(0x44), true
	case 0x30FB: return byte(0x81), byte(0x45), true
	case 0xFF1A: return byte(0x81), byte(0x46), true
	case 0xFF1B: return byte(0x81), byte(0x47), true
	case 0xFF1F: return byte(0x81), byte(0x48), true
	case 0xFF01: return byte(0x81), byte(0x49), true
	case 0x30FC: return byte(0x81), byte(0x5B), true
	case 0x2015: return byte(0x81), byte(0x5C), true
	case 0x2010: return byte(0x81), byte(0x5D), true
	case 0xFF0F: return byte(0x81), byte(0x5E), true
	case 0xFF5E: return byte(0x81), byte(0x60), true
	case 0xFF08: return byte(0x81), byte(0x69), true
	case 0xFF09: return byte(0x81), byte(0x6A), true
	case 0x300C: return byte(0x81), byte(0x75), true
	case 0x300D: return byte(0x81), byte(0x76), true
	case 0x300E: return byte(0x81), byte(0x77), true
	case 0x300F: return byte(0x81), byte(0x78), true
	case 0xFF0B: return byte(0x81), byte(0x7B), true
	case 0xFF0D: return byte(0x81), byte(0x7C), true
	case 0xFF1D: return byte(0x81), byte(0x81), true
	}

	b1, b2, ok := encodeCommonKanji(cp)
	return b1, b2, ok
}

func decodeCommonKanji(b1 int, b2 int) (uint, bool) {
	if b1 == 0x93 && b2 == 0xFA { return 0x65E5, true }
	if b1 == 0x96 && b2 == 0x7B { return 0x672C, true }
	if b1 == 0x8C && b2 == 0xEA { return 0x8A9E, true }
	if b1 == 0x93 && b2 == 0x8C { return 0x6771, true }
	if b1 == 0x8B && b2 == 0x9E { return 0x4EAC, true }
	if b1 == 0x8F && b2 == 0x6F { return 0x51FA, true }
	if b1 == 0x97 && b2 == 0xCD { return 0x529B, true }
	if b1 == 0x95 && b2 == 0xCF { return 0x5909, true }
	if b1 == 0x8A && b2 == 0xB7 { return 0x63DB, true }
	if b1 == 0x95 && b2 == 0xB6 { return 0x6587, true }
	if b1 == 0x8E && b2 == 0x9A { return 0x5B57, true }
	if b1 == 0x97 && b2 == 0xF1 { return 0x5217, true }
	if b1 == 0x89 && b2 == 0xBB { return 0x5316, true }
	if b1 == 0x8A && b2 == 0x4A { return 0x958B, true }
	if b1 == 0x94 && b2 == 0xAD { return 0x767A, true }
	if b1 == 0x8E && b2 == 0xC0 { return 0x5B9F, true }
	if b1 == 0x8C && b2 == 0x9F { return 0x691C, true }
	if b1 == 0x8F && b2 == 0xD8 { return 0x8A3C, true }
	return 0, false
}

func encodeCommonKanji(cp uint) (byte, byte, bool) {
	switch cp {
	case 0x65E5: return byte(0x93), byte(0xFA), true
	case 0x672C: return byte(0x96), byte(0x7B), true
	case 0x8A9E: return byte(0x8C), byte(0xEA), true
	case 0x6771: return byte(0x93), byte(0x8C), true
	case 0x4EAC: return byte(0x8B), byte(0x9E), true
	case 0x51FA: return byte(0x8F), byte(0x6F), true
	case 0x529B: return byte(0x97), byte(0xCD), true
	case 0x5909: return byte(0x95), byte(0xCF), true
	case 0x63DB: return byte(0x8A), byte(0xB7), true
	case 0x6587: return byte(0x95), byte(0xB6), true
	case 0x5B57: return byte(0x8E), byte(0x9A), true
	case 0x5217: return byte(0x97), byte(0xF1), true
	case 0x5316: return byte(0x89), byte(0xBB), true
	case 0x958B: return byte(0x8A), byte(0x4A), true
	case 0x767A: return byte(0x94), byte(0xAD), true
	case 0x5B9F: return byte(0x8E), byte(0xC0), true
	case 0x691C: return byte(0x8C), byte(0x9F), true
	case 0x8A3C: return byte(0x8F), byte(0xD8), true
	}
	return byte(0), byte(0), false
}

func appendUTF8(out *[]byte, cp uint) {
	if cp <= 0x7F {
		*out = append(*out, byte(cp))
	} else if cp <= 0x7FF {
		*out = append(*out,
			byte(0xC0 | (cp >> 6)),
			byte(0x80 | (cp & 0x3F)),
		)
	} else if cp <= 0xFFFF {
		*out = append(*out,
			byte(0xE0 | (cp >> 12)),
			byte(0x80 | ((cp >> 6) & 0x3F)),
			byte(0x80 | (cp & 0x3F)),
		)
	} else {
		*out = append(*out,
			byte(0xF0 | (cp >> 18)),
			byte(0x80 | ((cp >> 12) & 0x3F)),
			byte(0x80 | ((cp >> 6) & 0x3F)),
			byte(0x80 | (cp & 0x3F)),
		)
	}
}