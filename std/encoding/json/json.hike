package json

import "std/io"
import "std/strconv"
import "std/errors"

// Encoder is the minimal streaming JSON surface required by compiler tools.
// The native self-hosting path can replace the body with the full encoder
// implementation later without changing callers.
type Encoder struct {
	w io.Writer
	prefix string
	indent string
}

func NewEncoder(w io.Writer) *Encoder {
	return &Encoder{w: w}
}

func (e *Encoder) SetIndent(prefix string, indent string) {
	e.prefix = prefix
	e.indent = indent
}

func (e *Encoder) Encode(v any) error {
	if e == nil || e.w == nil { return errors.New("json: nil encoder") }
	value, ok := v.(*JSONValue)
	if !ok { return errors.New("json: unsupported value") }
	text := Stringify(value) + "\n"
	_, err := e.w.Write([]byte(text))
	return err
}

// C-ABI 標準ライブラリ宣言
func fopen(filename cstring, mode cstring) *byte
func fclose(fp *byte) int
func fseek(fp *byte, offset int, whence int) int
func ftell(fp *byte) int
func fread(buffer *byte, size int, count int, fp *byte) int
func fwrite(buffer *byte, size int, count int, fp *byte) int
func malloc(size int) *byte
func free(ptr *byte)
func strlen(s cstring) int
func atoi(s cstring) int
func atof(s cstring) float64

// JSON 型定義定数
const (
    TypeNull   int = 0
    TypeBool   int = 1
    TypeNumber int = 2
    TypeString int = 3
    TypeArray  int = 4
    TypeObject int = 5
)

// JSON ノード構造体
type JSONValue struct {
    Type      int
    BoolVal   bool
    NumVal    float64
    StrVal    string
    ArrVal    []*JSONValue
    ObjKeys   []string
    ObjVals   []*JSONValue
}

// -------------------------------------------------------------
// ファクトリ関数
// -------------------------------------------------------------

func NewNull() *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeNull
    return v
}

func NewBool(b bool) *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeBool
    v.BoolVal = b
    return v
}

func NewNumber(n float64) *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeNumber
    v.NumVal = n
    return v
}

func NewString(s string) *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeString
    v.StrVal = s
    return v
}

func NewArray() *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeArray
    v.ArrVal = make([]*JSONValue, 0, 8)
    return v
}

func NewObject() *JSONValue {
    v := (*JSONValue)(malloc(128))
    v.Type = TypeObject
    v.ObjKeys = make([]string, 0, 8)
    v.ObjVals = make([]*JSONValue, 0, 8)
    return v
}

// -------------------------------------------------------------
// オブジェクト / 配列 操作メソッド
// -------------------------------------------------------------

func replaceValue(dst *JSONValue, src *JSONValue) {
    if dst == nil || src == nil { return }
    dst.Type = src.Type
    dst.BoolVal = src.BoolVal
    dst.NumVal = src.NumVal
    dst.StrVal = src.StrVal
    dst.ArrVal = src.ArrVal
    dst.ObjKeys = src.ObjKeys
    dst.ObjVals = src.ObjVals
}

func (v *JSONValue) Set(key string, val *JSONValue) {
    if v == nil || v.Type != TypeObject { return }
    for i := 0; i < len(v.ObjKeys); i = i + 1 {
        if v.ObjKeys[i] == key {
            if v.ObjVals[i] == nil { v.ObjVals[i] = val } else { replaceValue(v.ObjVals[i], val) }
            return
        }
    }
    v.ObjKeys = append(v.ObjKeys, key)
    v.ObjVals = append(v.ObjVals, val)
}

// JSONValue_Set is a compatibility entry point for the bootstrap compiler's
// method lowering when a JSON value is represented as a slice-shaped value.
func JSONValue_Set(v []JSONValue, key string, val *JSONValue) {
    if len(v) == 0 { return }
    v[0].Set(key, val)
}

func SetValue(v *JSONValue, key string, val *JSONValue) {
    if v == nil || v.Type != TypeObject { return }
    for i := 0; i < len(v.ObjKeys); i = i + 1 {
        if v.ObjKeys[i] == key {
            if v.ObjVals[i] == nil { v.ObjVals[i] = val } else { replaceValue(v.ObjVals[i], val) }
            return
        }
    }
    v.ObjKeys = append(v.ObjKeys, key)
    v.ObjVals = append(v.ObjVals, val)
}

func (v *JSONValue) Get(key string) *JSONValue {
    if v.Type != TypeObject {
        return nil
    }
    for i := 0; i < len(v.ObjKeys); i = i + 1 {
        if v.ObjKeys[i] == key {
            return v.ObjVals[i]
        }
    }
    return nil
}

func (v *JSONValue) Append(elem *JSONValue) {
    if v.Type != TypeArray {
        return
    }
    v.ArrVal = append(v.ArrVal, elem)
}

func (v *JSONValue) At(idx int) *JSONValue {
    if v.Type != TypeArray || idx < 0 || idx >= len(v.ArrVal) {
        return nil
    }
    return v.ArrVal[idx]
}

func (v *JSONValue) AsInt() int {
    return int(v.NumVal)
}

func (v *JSONValue) AsFloat() float64 {
    return v.NumVal
}

func (v *JSONValue) AsString() string {
    return v.StrVal
}

func (v *JSONValue) AsBool() bool {
    return v.BoolVal
}

// -------------------------------------------------------------
// JSON パーサー実装
// -------------------------------------------------------------

type Parser struct {
    src string
    pos int
    len int
}

func (p *Parser) skipWhitespace() {
    for p.pos < p.len {
        ch := p.src[p.pos]
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            p.pos = p.pos + 1
        } else {
            break
        }
    }
}

func (p *Parser) parseString() string {
    p.pos = p.pos + 1
    start := p.pos
    for p.pos < p.len && p.src[p.pos] != 34 {
        if p.src[p.pos] == 92 && p.pos+1 < p.len {
            p.pos = p.pos + 2
        } else {
            p.pos = p.pos + 1
        }
    }
    s := p.src[start:p.pos]
    if p.pos < p.len {
        p.pos = p.pos + 1
    }
    return s
}

func (p *Parser) parseNumber() *JSONValue {
    start := p.pos
    if p.src[p.pos] == 45 {
        p.pos = p.pos + 1
    }
    for p.pos < p.len {
        ch := p.src[p.pos]
        if (ch >= 48 && ch <= 57) || ch == 46 {
            p.pos = p.pos + 1
        } else {
            break
        }
    }
    numStr := p.src[start:p.pos]
    val := atof(cstring(numStr))
    return NewNumber(val)
}

func (p *Parser) parseArray() *JSONValue {
    arr := NewArray()
    p.pos = p.pos + 1
    p.skipWhitespace()

    if p.pos < p.len && p.src[p.pos] == 93 {
        p.pos = p.pos + 1
        return arr
    }

    for p.pos < p.len {
        elem := p.parseValue()
        if elem != nil {
            arr.Append(elem)
        }
        p.skipWhitespace()
        if p.pos < p.len && p.src[p.pos] == 44 {
            p.pos = p.pos + 1
            p.skipWhitespace()
        } else if p.pos < p.len && p.src[p.pos] == 93 {
            p.pos = p.pos + 1
            break
        } else {
            break
        }
    }
    return arr
}

func (p *Parser) parseObject() *JSONValue {
    obj := NewObject()
    p.pos = p.pos + 1
    p.skipWhitespace()

    if p.pos < p.len && p.src[p.pos] == 125 {
        p.pos = p.pos + 1
        return obj
    }

    for p.pos < p.len {
        p.skipWhitespace()
        if p.src[p.pos] != 34 {
            break
        }
        key := p.parseString()
        p.skipWhitespace()

        if p.pos < p.len && p.src[p.pos] == 58 {
            p.pos = p.pos + 1
        }

        val := p.parseValue()
        SetValue(obj, key, val)

        p.skipWhitespace()
        if p.pos < p.len && p.src[p.pos] == 44 {
            p.pos = p.pos + 1
            p.skipWhitespace()
        } else if p.pos < p.len && p.src[p.pos] == 125 {
            p.pos = p.pos + 1
            break
        } else {
            break
        }
    }
    return obj
}

func (p *Parser) parseValue() *JSONValue {
    p.skipWhitespace()
    if p.pos >= p.len {
        return nil
    }

    ch := p.src[p.pos]
    if ch == 123 {
        return p.parseObject()
    } else if ch == 91 {
        return p.parseArray()
    } else if ch == 34 {
        return NewString(p.parseString())
    } else if (ch >= 48 && ch <= 57) || ch == 45 {
        return p.parseNumber()
    } else if ch == 116 {
        p.pos = p.pos + 4
        return NewBool(true)
    } else if ch == 102 {
        p.pos = p.pos + 5
        return NewBool(false)
    } else if ch == 110 {
        p.pos = p.pos + 4
        return NewNull()
    }
    return nil
}

func Parse(jsonStr string) *JSONValue {
    p := Parser{
        src: jsonStr,
        pos: 0,
        len: len(jsonStr),
    }
    return p.parseValue()
}

// -------------------------------------------------------------
// JSON シリアライザー実装
// -------------------------------------------------------------

func Stringify(v *JSONValue) string {
    if v == nil || v.Type == TypeNull {
        return "null"
    }
    if v.Type == TypeBool {
        if v.BoolVal {
            return "true"
        }
        return "false"
    }
    if v.Type == TypeNumber {
        if v.NumVal == float64(int(v.NumVal)) {
            return strconv.Itoa(int(v.NumVal))
        }
        return strconv.FormatFloat(v.NumVal, byte(102), -1, 64)
    }
    if v.Type == TypeString {
        return "\"" + v.StrVal + "\""
    }
    if v.Type == TypeArray {
        res := "["
        for i := 0; i < len(v.ArrVal); i = i + 1 {
            if i > 0 {
                res = res + ", "
            }
            res = res + Stringify(v.ArrVal[i])
        }
        return res + "]"
    }
    if v.Type == TypeObject {
        res := "{"
        for i := 0; i < len(v.ObjKeys); i = i + 1 {
            if i > 0 {
                res = res + ", "
            }
            res = res + "\"" + v.ObjKeys[i] + "\": " + Stringify(v.ObjVals[i])
        }
        return res + "}"
    }
    return "null"
}

// -------------------------------------------------------------
// ファイル I/O ヘルパー
// -------------------------------------------------------------

func ReadFile(filename string) string {
    fp := fopen(cstring(filename), cstring("rb"))
    if fp == nil {
        return ""
    }
    fseek(fp, 0, 2)
    size := ftell(fp)
    fseek(fp, 0, 0)

    buf := malloc(size + 1)
    fread(buf, 1, size, fp)
    fclose(fp)

    buf[size] = 0
    return string(buf)
}

func WriteFile(filename string, content string) bool {
    fp := fopen(cstring(filename), cstring("wb"))
    if fp == nil {
        return false
    }
    size := len(content)
    wrote := fwrite((*byte)(content), 1, size, fp)
    fclose(fp)
    return wrote == size
}

func MarshalIndent(v any, prefix string, indent string) ([]byte, error) {
	value, ok := v.(*JSONValue)
	if !ok { return nil, errors.New("json: unsupported value") }
	return []byte(prefix + Stringify(value)), nil
}
