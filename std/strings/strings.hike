package strings

func HasPrefix(s string, prefix string) bool {
	lenS := len(s)
	lenP := len(prefix)
	if lenP > lenS {
		return false
	}
	return s[0:lenP] == prefix
}

func HasSuffix(s string, suffix string) bool {
	lenS := len(s)
	lenSuff := len(suffix)
	if lenSuff > lenS {
		return false
	}
	return s[lenS-lenSuff:lenS] == suffix
}

func Index(s string, substr string) int {
	lenS := len(s)
	lenSub := len(substr)
	if lenSub == 0 {
		return 0
	}
	if lenSub > lenS {
		return -1
	}
	limit := lenS - lenSub
	for i := 0; i <= limit; i++ {
		if s[i:i+lenSub] == substr {
			return i
		}
	}
	return -1
}

func Contains(s string, substr string) bool {
	return Index(s, substr) >= 0
}

func Count(s string, substr string) int {
	lenS := len(s)
	lenSub := len(substr)
	if lenSub == 0 {
		return lenS + 1
	}
	if lenSub > lenS {
		return 0
	}
	count := 0
	i := 0
	limit := lenS - lenSub
	for i <= limit {
		if s[i:i+lenSub] == substr {
			count++
			i += lenSub
		} else {
			i++
		}
	}
	return count
}

func Repeat(s string, count int) string {
	if count <= 0 {
		return ""
	}
	res := ""
	for i := 0; i < count; i++ {
		res = res + s
	}
	return res
}

func Join(elems []string, sep string) string {
	if len(elems) == 0 {
		return ""
	}
	res := elems[0]
	for i := 1; i < len(elems); i++ {
		res = res + sep + elems[i]
	}
	return res
}

func Split(s string, sep string) []string {
	res := make([]string, 0)
	lenS := len(s)
	lenSep := len(sep)
	if lenSep == 0 {
		for i := 0; i < lenS; i++ {
			res = append(res, s[i:i+1])
		}
		return res
	}
	pos := 0
	for pos <= lenS {
		idx := Index(s[pos:lenS], sep)
		if idx < 0 {
			res = append(res, s[pos:lenS])
			break
		}
		res = append(res, s[pos:pos+idx])
		pos = pos + idx + lenSep
	}
	return res
}

func ToUpper(s string) string {
	lenS := len(s)
	buf := make([]byte, lenS)
	for i := 0; i < lenS; i++ {
		c := s[i]
		if c >= 97 && c <= 122 {
			buf[i] = c - 32
		} else {
			buf[i] = c
		}
	}
	return string(buf)
}

func ToLower(s string) string {
	lenS := len(s)
	buf := make([]byte, lenS)
	for i := 0; i < lenS; i++ {
		c := s[i]
		if c >= 65 && c <= 90 {
			buf[i] = c + 32
		} else {
			buf[i] = c
		}
	}
	return string(buf)
}

func TrimSpace(s string) string {
	lenS := len(s)
	start := 0
	for start < lenS {
		c := s[start]
		if c == 32 || c == 9 || c == 10 || c == 13 {
			start++
		} else {
			break
		}
	}
	end := lenS
	for end > start {
		c := s[end-1]
		if c == 32 || c == 9 || c == 10 || c == 13 {
			end--
		} else {
			break
		}
	}
	return s[start:end]
}

func ReplaceAll(s string, old string, new string) string {
	if len(old) == 0 {
		return s
	}
	parts := Split(s, old)
	return Join(parts, new)
}
