package strings

func strlen(s *byte) int
func memcmp(s1 *byte, s2 *byte, n int) int

func Len(s *byte) int {
	if s == nil {
		return 0
	}
	return strlen(s)
}

func Equal(a *byte, b *byte) bool {
	if a == b {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	la := strlen(a)
	lb := strlen(b)
	if la != lb {
		return false
	}
	return memcmp(a, b, la) == 0
}

func HasPrefix(s *byte, prefix *byte) bool {
	if s == nil || prefix == nil {
		return false
	}
	prefixLen := strlen(prefix)
	sLen := strlen(s)
	if sLen < prefixLen {
		return false
	}
	return memcmp(s, prefix, prefixLen) == 0
}

func HasSuffix(s *byte, suffix *byte) bool {
	if s == nil || suffix == nil {
		return false
	}
	suffixLen := strlen(suffix)
	sLen := strlen(s)
	if sLen < suffixLen {
		return false
	}
	offset := sLen - suffixLen
	return memcmp(s+offset, suffix, suffixLen) == 0
}
