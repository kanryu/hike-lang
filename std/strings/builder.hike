package strings

func malloc(size int) *byte
func free(ptr *byte)
func memcpy(dst *byte, src *byte, n int) *byte
func strlen(s *byte) int

type Builder struct {
	buf *byte
	len int
	cap int
}

func NewBuilder(initCap int) *Builder {
	if initCap <= 0 {
		initCap = 32
	}
	b := (*Builder)(malloc(24))
	b.buf = malloc(initCap)
	b.len = 0
	b.cap = initCap
	b.buf[0] = 0
	return b
}

func (b *Builder) WriteString(s *byte) {
	if s == nil {
		return
	}
	addLen := strlen(s)
	if addLen == 0 {
		return
	}
	needCap := b.len + addLen + 1
	if needCap > b.cap {
		newCap := b.cap * 2
		for newCap < needCap {
			newCap = newCap * 2
		}
		newBuf := malloc(newCap)
		if b.len > 0 {
			memcpy(newBuf, b.buf, b.len)
		}
		free(b.buf)
		b.buf = newBuf
		b.cap = newCap
	}
	// b.buf + b.len のポインタ位置へ文字列をコピー
	memcpy(b.buf+b.len, s, addLen)
	b.len = b.len + addLen
	b.buf[b.len] = 0
}

func (b *Builder) String() *byte {
	return b.buf
}

func (b *Builder) Len() int {
	return b.len
}

func (b *Builder) Free() {
	if b.buf != nil {
		free(b.buf)
		b.buf = nil
	}
	free((*byte)(b))
}
