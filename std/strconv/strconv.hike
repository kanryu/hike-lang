package strconv

import (
	"std/errors"
)

func Itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := false
	val := n
	if val < 0 {
		neg = true
		val = -val
	}
	buf := make([]byte, 32)
	pos := 30
	buf[31] = byte(0)
	for val > 0 {
		rem := val % 10
		buf[pos] = byte(48 + rem)
		pos--
		val = val / 10
	}
	if neg {
		buf[pos] = byte(45) // '-'
		pos--
	}
	start := pos + 1
	return string(buf[start:31])
}

func Atoi(s string) (int, error) {
	if len(s) == 0 {
		return 0, errors.New("empty string")
	}
	neg := false
	idx := 0
	if s[0] == byte(45) { // '-'
		neg = true
		idx = 1
	} else if s[0] == byte(43) { // '+'
		idx = 1
	}
	if idx >= len(s) {
		return 0, errors.New("invalid syntax")
	}
	res := 0
	for idx < len(s) {
		c := s[idx]
		if c < byte(48) || c > byte(57) {
			return 0, errors.New("invalid syntax")
		}
		res = res*10 + (int(c) - 48)
		idx++
	}
	if neg {
		res = -res
	}
	return res, nil
}

func FormatInt(val int, base int) string {
	if base < 2 || base > 36 {
		return ""
	}
	if val == 0 {
		return "0"
	}
	neg := false
	n := val
	if n < 0 {
		neg = true
		n = -n
	}
	digits := "0123456789abcdefghijklmnopqrstuvwxyz"
	buf := make([]byte, 70)
	pos := 68
	buf[69] = byte(0)
	for n > 0 {
		rem := n % base
		buf[pos] = digits[rem]
		pos--
		n = n / base
	}
	if neg {
		buf[pos] = byte(45) // '-'
		pos--
	}
	start := pos + 1
	return string(buf[start:69])
}

// FormatFloat is a minimal wasm self-hosting fallback. The compiler uses it
// only while spelling WAT constants; integer-oriented compiler paths do not
// require the full Go floating-point formatter.
func FormatFloat(val float64, format byte, precision int, bitSize int) string {
	if val == 0.0 { return "0" }
	return "0"
}

func ParseInt(s string, base int, bitSize int) (int, error) {
	if len(s) == 0 {
		return 0, errors.New("empty string")
	}
	if base < 2 || base > 36 {
		return 0, errors.New("invalid base")
	}
	neg := false
	idx := 0
	if s[0] == byte(45) { // '-'
		neg = true
		idx = 1
	} else if s[0] == byte(43) { // '+'
		idx = 1
	}
	if idx >= len(s) {
		return 0, errors.New("invalid syntax")
	}
	res := 0
	for idx < len(s) {
		c := s[idx]
		val := -1
		if c >= byte(48) && c <= byte(57) {
			val = int(c) - 48
		} else if c >= byte(97) && c <= byte(122) {
			val = int(c) - 97 + 10
		} else if c >= byte(65) && c <= byte(90) {
			val = int(c) - 65 + 10
		}
		if val < 0 || val >= base {
			return 0, errors.New("invalid syntax")
		}
		res = res*base + val
		idx++
	}
	if neg {
		res = -res
	}
	return res, nil
}

func ParseFloat(s string, bitSize int) (float64, error) {
	if len(s) == 0 { return 0.0, errors.New("empty string") }
	neg := false
	i := 0
	if s[0] == byte(45) { neg = true; i++ }
	if i < len(s) && s[i] == byte(43) { i++ }
	value := 0.0
	digits := 0
	for i < len(s) && s[i] >= byte(48) && s[i] <= byte(57) {
		value = value*10.0 + float64(int(s[i])-48)
		digits++
		i++
	}
	if i < len(s) && s[i] == byte(46) {
		i++
		place := 0.1
		for i < len(s) && s[i] >= byte(48) && s[i] <= byte(57) {
			value = value + float64(int(s[i])-48)*place
			place = place * 0.1
			digits++
			i++
		}
	}
	if digits == 0 { return 0.0, errors.New("invalid syntax") }
	if i < len(s) && (s[i] == byte(101) || s[i] == byte(69)) {
		i++
		expNeg := false
		if i < len(s) && s[i] == byte(45) { expNeg = true; i++ }
		if i < len(s) && s[i] == byte(43) { i++ }
		exp := 0
		for i < len(s) && s[i] >= byte(48) && s[i] <= byte(57) {
			exp = exp*10 + int(s[i])-48
			i++
		}
		if exp == 0 && (i == 0 || (s[i-1] < byte(48) || s[i-1] > byte(57))) { return 0.0, errors.New("invalid syntax") }
		factor := 1.0
		for j := 0; j < exp; j++ { factor = factor * 10.0 }
		if expNeg { value = value / factor } else { value = value * factor }
	}
	if i != len(s) { return 0.0, errors.New("invalid syntax") }
	if neg { value = -value }
	return value, nil
}
