//hike:build linux || darwin

package os

// POSIX専用のネイティブ層。
// 公開APIは os.hike に置き、ここでは各OS実装から利用する内部ヘルパーだけを定義する。
cfunc posixMkdir(path cstring, mode int) int = mkdir
cfunc posixRmdir(path cstring) int = rmdir
cfunc posixChdir(path cstring) int = chdir
cfunc posixGetcwd(buffer *byte, size int) cstring = getcwd
cfunc posixUnlink(path cstring) int = unlink
cfunc posixRename(oldPath cstring, newPath cstring) int = rename
cfunc posixGetpid() int = getpid
cfunc posixGetenv(name cstring) cstring = getenv
cfunc posixSetenv(name cstring, value cstring, overwrite int) int = setenv
cfunc posixUnsetenv(name cstring) int = unsetenv
cfunc posixRealpath(path cstring, resolved *byte) cstring = realpath
cfunc posixOpenDir(path cstring) *byte = opendir
cfunc posixReadDir(handle *byte) *byte = readdir
cfunc posixCloseDir(handle *byte) int = closedir

func osNativeGetenv(name string) (string, bool) {
	raw := posixGetenv(cstring(name))
	if raw == nil { return "", false }
	return string(raw), true
}
func osNativeSetenv(name string, value string) error {
	if posixSetenv(cstring(name), cstring(value), 1) != 0 { return errors.New("setenv failed") }
	return nil
}
func osNativeUnsetenv(name string) error {
	if posixUnsetenv(cstring(name)) != 0 { return errors.New("unsetenv failed") }
	return nil
}
func osNativeClearenv() {}
func osNativeExpandEnv(value string) string { return value }

func osNativeGetwd() (string, error) {
	buffer := make([]byte, 4096)
	raw := posixGetcwd(&buffer[0], len(buffer))
	if raw == nil { return "", errors.New("getcwd failed") }
	return string(raw), nil
}
func osNativeExecutable() (string, error) { return "hikec", nil }
func osNativeTempDir() string {
	if value, ok := osNativeGetenv("TMPDIR"); ok && value != "" { return value }
	return "/tmp"
}
func osNativeGetpid() int { return posixGetpid() }
func osNativeRename(oldPath string, newPath string) error {
	if posixRename(cstring(oldPath), cstring(newPath)) != 0 { return &PathError{Op: "rename", Path: oldPath, Err: ErrNotExist} }
	return nil
}
func osNativeMkdir(path string, perm FileMode) error {
	if posixMkdir(cstring(path), int(perm)&0777) != 0 { return &PathError{Op: "mkdir", Path: path, Err: ErrPermission} }
	return nil
}
func osNativeMkdirAll(path string, perm FileMode) error { return osNativeMkdir(path, perm) }
func osNativeRemoveAll(path string) error {
	// POSIX rmdir only removes empty directories, so remove children first.
	handle := posixOpenDir(cstring(path))
	if handle != nil {
		for {
			raw := posixReadDir(handle)
			if raw == nil { break }
			name := posixDirentName(raw)
			if name == "." || name == ".." { continue }
			child := path + "/" + name
			if posixDirentIsDir(raw) {
				if err := osNativeRemoveAll(child); err != nil {
					posixCloseDir(handle)
					return err
				}
			} else if posixUnlink(cstring(child)) != 0 {
				posixCloseDir(handle)
				return &PathError{Op: "remove", Path: child, Err: ErrNotExist}
			}
		}
		posixCloseDir(handle)
		if posixRmdir(cstring(path)) == 0 { return nil }
	}
	if posixUnlink(cstring(path)) == 0 { return nil }
	return &PathError{Op: "remove", Path: path, Err: ErrNotExist}
}
func osNativeReadDir(path string) ([]*DirEntry, error) {
	handle := posixOpenDir(cstring(path))
	if handle == nil { return nil, &PathError{Op: "readdir", Path: path, Err: ErrNotExist} }
	entries := make([]*DirEntry, 0)
	for {
		raw := posixReadDir(handle)
		if raw == nil { break }
		name := posixDirentName(raw)
		if name != "." && name != ".." {
			entries = append(entries, &DirEntry{name: name, dir: posixDirentIsDir(raw)})
		}
	}
	posixCloseDir(handle)
	return entries, nil
}

func osNativeStat(path string) (*FileInfo, error) {
	// The bootstrap compiler only needs existence and directory information
	// while resolving modules.  Reuse directory enumeration to avoid adding a
	// platform-specific stat ABI to the minimal POSIX compatibility layer.
	if handle := posixOpenDir(cstring(path)); handle != nil {
		posixCloseDir(handle)
		return &FileInfo{name: path, mode: 0, dir: true}, nil
	}
	f, err := Open(path)
	if err != nil { return nil, err }
	defer f.Close()
	if fseek(f.handle, 0, 2) != 0 { return nil, errors.New("stat seek failed") }
	size := ftell(f.handle)
	if size < 0 { return nil, errors.New("stat tell failed") }
	return &FileInfo{name: path, size: int64(size), mode: 0, dir: false}, nil
}
