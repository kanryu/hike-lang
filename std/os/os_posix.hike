//hike:build linux || darwin

package os

// POSIX専用のネイティブ層。
// 公開APIは os.hike に置き、ここでは各OS実装から利用する内部ヘルパーだけを定義する。
cfunc posixMkdir(path string, mode int) int = mkdir
cfunc posixRmdir(path string) int = rmdir
cfunc posixChdir(path string) int = chdir
cfunc posixGetcwd(buffer *byte, size int) *byte = getcwd
cfunc posixUnlink(path string) int = unlink
cfunc posixRename(oldPath string, newPath string) int = rename
cfunc posixGetpid() int = getpid
cfunc posixGetenv(name string) *byte = getenv
cfunc posixSetenv(name string, value string, overwrite int) int = setenv
cfunc posixUnsetenv(name string) int = unsetenv
cfunc posixRealpath(path string, resolved *byte) *byte = realpath
cfunc posixOpenDir(path string) *byte = opendir
cfunc posixReadDir(handle *byte) *byte = readdir
cfunc posixCloseDir(handle *byte) int = closedir

func osNativeGetenv(name string) (string, bool) {
	raw := posixGetenv(name)
	if raw == nil { return "", false }
	return string(raw), true
}
func osNativeSetenv(name string, value string) error {
	if posixSetenv(name, value, 1) != 0 { return errors.New("setenv failed") }
	return nil
}
func osNativeUnsetenv(name string) error {
	if posixUnsetenv(name) != 0 { return errors.New("unsetenv failed") }
	return nil
}
func osNativeClearenv() {}
func osNativeExpandEnv(value string) string { return value }

func osNativeGetwd() (string, error) {
	buffer := make([]byte, 4096)
	raw := posixGetcwd(&buffer[0], len(buffer))
	if raw == nil { return "", errors.New("getcwd failed") }
	return string(raw), nil
}
func osNativeExecutable() (string, error) { return "hikec", nil }
func osNativeTempDir() string {
	if value, ok := osNativeGetenv("TMPDIR"); ok && value != "" { return value }
	return "/tmp"
}
func osNativeGetpid() int { return posixGetpid() }
func osNativeRename(oldPath string, newPath string) error {
	if posixRename(oldPath, newPath) != 0 { return &PathError{Op: "rename", Path: oldPath, Err: ErrNotExist} }
	return nil
}
func osNativeMkdir(path string, perm FileMode) error {
	if posixMkdir(path, int(perm.Perm())) != 0 { return &PathError{Op: "mkdir", Path: path, Err: ErrPermission} }
	return nil
}
func osNativeMkdirAll(path string, perm FileMode) error { return osNativeMkdir(path, perm) }
func osNativeRemoveAll(path string) error {
	if posixUnlink(path) == 0 { return nil }
	if posixRmdir(path) == 0 { return nil }
	return &PathError{Op: "remove", Path: path, Err: ErrNotExist}
}
func osNativeReadDir(path string) ([]*DirEntry, error) {
	handle := posixOpenDir(path)
	if handle == nil { return nil, &PathError{Op: "readdir", Path: path, Err: ErrNotExist} }
	entries := make([]*DirEntry, 0)
	for {
		raw := posixReadDir(handle)
		if raw == nil { break }
		name := posixDirentName(raw)
		if name != "." && name != ".." {
			entries = append(entries, &DirEntry{name: name, dir: posixDirentIsDir(raw)})
		}
	}
	posixCloseDir(handle)
	return entries, nil
}
