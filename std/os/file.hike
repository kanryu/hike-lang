package os

// C標準入出力・システム関数の宣言
func fopen(filename *byte, mode *byte) *byte
func fclose(stream *byte) int
func fread(ptr *byte, size int, count int, stream *byte) int
func fwrite(ptr *byte, size int, count int, stream *byte) int
func fseek(stream *byte, offset int, whence int) int
func ftell(stream *byte) int
func malloc(size int) *byte
func free(ptr *byte)
func exit(status int)

type File struct {
	handle *byte
}

// Open: ファイルを指定したモード ("r", "w", "rb", "wb" 等) で開きます
func Open(filename *byte, mode *byte) *File {
	fp := fopen(filename, mode)
	if fp == nil {
		return nil
	}
	f := (*File)(malloc(8)) // handleポインタの保持用
	f.handle = fp
	return f
}

// Read: 開いたファイルから指定バイト数をバッファへ読み込みます
func (f *File) Read(buf *byte, size int) int {
	if f == nil || f.handle == nil {
		return 0
	}
	return fread(buf, 1, size, f.handle)
}

// Write: 開いたファイルへバッファの内容を書き込みます
func (f *File) Write(buf *byte, size int) int {
	if f == nil || f.handle == nil {
		return 0
	}
	return fwrite(buf, 1, size, f.handle)
}

// Close: ファイルストリームを閉じて構造体メモリを解放します
func (f *File) Close() int {
	if f == nil || f.handle == nil {
		return 0
	}
	res := fclose(f.handle)
	f.handle = nil
	free((*byte)(f))
	return res
}

// ReadFile: ソースコード読み込み用。ファイル全体を一括でメモリに読み込んでヌル終端文字列として返します
func ReadFile(filename *byte) *byte {
	fp := fopen(filename, "rb")
	if fp == nil {
		return nil
	}

	// ファイルサイズの取得 (SEEK_END = 2, SEEK_SET = 0)
	fseek(fp, 0, 2)
	size := ftell(fp)
	fseek(fp, 0, 0)

	if size < 0 {
		fclose(fp)
		return nil
	}

	// ヌル終端用の余白 (+1) を含めてメモリ確保
	buf := malloc(size + 1)
	readBytes := fread(buf, 1, size, fp)
	buf[readBytes] = 0

	fclose(fp)
	return buf
}

// WriteFile: IR出力用。メモリ上の文字列バッファを一括で指定ファイルへ書き出します
func WriteFile(filename *byte, content *byte, length int) int {
	fp := fopen(filename, "wb")
	if fp == nil {
		return 0
	}

	written := fwrite(content, 1, length, fp)
	fclose(fp)
	return written
}

// Exit: プロセスを終了コード付きで即時終了します
func Exit(code int) {
	exit(code)
}
