//hike:build windows

package memoryblock

import (
    "std/memorymap"
    "std/os"
)

// DeserializeMapped delegates Windows copy-on-write mapping, header
// validation, relocation access, and unmapping to std/memorymap.
func DeserializeMapped(path string) (*Mapping, error) {
    info, err := os.Stat(path)
    if err != nil || info == nil {
        return nil, err
    }
    mapped, err := memorymap.Map(path, info.Size())
    if err != nil {
        return nil, err
    }
    return &Mapping{
        Data: mapped.Data()[:],
        Pointers: mapped.PointerOffsets(),
        close: func() error { return mapped.Close() },
    }, nil
}
