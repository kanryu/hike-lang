package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func Step1(v int) int { return v + 10 }
func Step2(v int) int { return v * 2 }
func Step3(v int) int { return v - 5 }

func testOutput() string {
    pipeline := []func(int) int{Step1, Step2, Step3}

    val := 5
    for i := 0; i < len(pipeline); i = i + 1 {
        fn := pipeline[i]
        val = fn(val)
    }
    testOutputBuffer += sprintf.Sprintf("PIPELINE_RES=%d\n", val)
    return testOutputBuffer
}


func main() int { return 0 }
