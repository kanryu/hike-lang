package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












func testOutput() string {
    testOutputBuffer = ""
    // "こんにちは" は UTF-8 で各文字 3 バイト x 5 = 15 バイト
    s := "こんにちは"
    l := len(s)
    b0 := s[0]
    b1 := s[1]
    b2 := s[2]

    // 部分スライス (最初の 1 文字 = 先頭 3 バイト)
    firstChar := s[0:3]

    testOutputBuffer += sprintf.Sprintf("LEN=%d,BYTES=(%d,%d,%d),CHAR=%s\n", l, b0, b1, b2, firstChar)
    return testOutputBuffer
}


func main() int { return 0 }
