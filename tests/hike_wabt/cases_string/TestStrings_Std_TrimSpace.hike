package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












import "std/strings"

func testOutput() string {
    testOutputBuffer = ""
    dirty := "  \t Hello Hike! \n "
    clean := strings.TrimSpace(dirty)
    testOutputBuffer += sprintf.Sprintf("CLEAN=[%s]\n", clean)
    return testOutputBuffer
}


func main() int { return 0 }
