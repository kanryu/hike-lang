package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











type Circle struct {
    Radius int
}

func (c Circle) Area() int {
    return c.Radius * c.Radius * 3
}

type Square struct {
    Side int
}

func (s Square) Area() int {
    return s.Side * s.Side
}

func testOutput() string {
    c := Circle{Radius: 5}
    s := Square{Side: 8}
    testOutputBuffer += sprintf.Sprintf("CIRCLE=%d,SQUARE=%d\n", c.Area(), s.Area())
    return testOutputBuffer
}


func main() int { return 0 }
