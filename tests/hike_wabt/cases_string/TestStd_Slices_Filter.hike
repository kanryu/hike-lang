package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












import "std/slices"

func testOutput() string {
    testOutputBuffer = ""
    nums := []int{5, 2, 8, 1, 9, 4}
    evens := slices.Filter[int](nums, func(x int) bool {
        return x % 2 == 0
    })

    testOutputBuffer += sprintf.Sprintf("LEN=%d: ", len(evens))
    for i := 0; i < len(evens); i = i + 1 {
        testOutputBuffer += sprintf.Sprintf("%d ", evens[i])
    }
    testOutputBuffer += sprintf.Sprintf("\n")
    return testOutputBuffer
}


func main() int { return 0 }
