package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












func testOutput() string {
    testOutputBuffer = ""
    cs := cstring("HikeCString")

    // 1. インデックスアクセス (byte 取得)
    c0 := cs[0]
    c4 := cs[4]

    // 2. 部分文字列スライス切り出し
    sub := cs[4:11]

    testOutputBuffer += sprintf.Sprintf("C0=%c,C4=%c,SUB=%s\n", c0, c4, sub)
    return testOutputBuffer
}


func main() int { return 0 }
