package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












import "std/regexp"

func testOutput() string {
    testOutputBuffer = ""
    reLazy := regexp.MustCompile("<.*?>")
    res1 := reLazy.ReplaceAllString("<div>hello</div>", "[TAG]")

    reAnchor := regexp.MustCompile("^Hike.*2026$")
    m1 := reAnchor.MatchString("Hike Lang 2026")
    m2 := reAnchor.MatchString("Other Hike Lang 2026")

    testOutputBuffer += sprintf.Sprintf("RES1=%s,M1=%d,M2=%d\n", res1, m1, m2)
    return testOutputBuffer
}


func main() int { return 0 }
