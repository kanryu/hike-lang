package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func testOutput() string {
    signed := -8 >> 1
    highBit := uint32(1) << 31
    unsigned := highBit >> 1

    testOutputBuffer += sprintf.Sprintf("SIGNED=%d,UNSIGNED=%d\n", signed, unsigned)
    return testOutputBuffer
}


func main() int { return 0 }
