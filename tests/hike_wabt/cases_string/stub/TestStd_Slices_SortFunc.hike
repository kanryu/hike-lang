package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












import "std/slices"

func testOutput() string {
    testOutputBuffer = ""
    nums := []int{5, 2, 8, 1, 9, 4}
    slices.SortFunc[int](nums, func(a int, b int) int {
        return a - b
    })

    for i := 0; i < len(nums); i = i + 1 {
        testOutputBuffer += sprintf.Sprintf("%d ", nums[i])
    }
    testOutputBuffer += sprintf.Sprintf("\n")
    return testOutputBuffer
}


func main() int { return 0 }
