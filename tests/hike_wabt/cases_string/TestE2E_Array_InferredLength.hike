package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func testOutput() string {
    math_lut := [...]byte{
        0x01, 0x02, 0x04, 0x08,
        0x10, 0x20, 0x40, 0x80,
        0x1d, 0x3a, 0x74, 0xe8,
        0xcd, 0x87, 0x13, 0x26,
    }
    testOutputBuffer += sprintf.Sprintf("FIRST=%d,MIDDLE=%d,LAST=%d\n",
        math_lut[0], math_lut[8], math_lut[15])
    return testOutputBuffer
}


func main() int { return 0 }
