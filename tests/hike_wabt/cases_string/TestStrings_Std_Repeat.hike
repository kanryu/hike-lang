package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












import "std/strings"

func testOutput() string {
    testOutputBuffer = ""
    bar := strings.Repeat("-", 5)
    echo := strings.Repeat("Ha", 3)
    testOutputBuffer += sprintf.Sprintf("BAR=%s,ECHO=%s\n", bar, echo)
    return testOutputBuffer
}


func main() int { return 0 }
