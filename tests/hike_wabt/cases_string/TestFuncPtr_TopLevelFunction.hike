package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func Add(a int, b int) int {
    return a + b
}

func Multiply(a int, b int) int {
    return a * b
}

func Apply(op func(int, int) int, x int, y int) int {
    return op(x, y)
}

func testOutput() string {
    var fn func(int, int) int = Add
    r1 := fn(10, 20)
    fn = Multiply
    r2 := fn(10, 20)
    r3 := Apply(Add, 30, 40)
    r4 := Apply(Multiply, 5, 6)

    testOutputBuffer += sprintf.Sprintf("R1=%d,R2=%d,R3=%d,R4=%d\n", r1, r2, r3, r4)
    return testOutputBuffer
}


func main() int { return 0 }
