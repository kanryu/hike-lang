package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func fib(n int) int {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

func testOutput() string {
    testOutputBuffer += sprintf.Sprintf("FIB(10)=%d\n", fib(10))
    return testOutputBuffer
}


func main() int { return 0 }
