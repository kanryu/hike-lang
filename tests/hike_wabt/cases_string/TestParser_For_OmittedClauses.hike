package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""












func testOutput() string {
    testOutputBuffer = ""
    // 1. 初期化節省略: for ; i < 3; i++
    i := 0
    sum1 := 0
    for ; i < 3; i++ {
        sum1 = sum1 + i
    }

    // 2. 後置節省略: for j := 0; j < 3;
    sum2 := 0
    for j := 0; j < 3; {
        sum2 = sum2 + j
        j++
    }

    // 3. 条件節のみ (whileスタイル): for k < 3
    k := 0
    sum3 := 0
    for k < 3 {
        sum3 = sum3 + k
        k++
    }

    testOutputBuffer += sprintf.Sprintf("SUM1=%d,SUM2=%d,SUM3=%d\n", sum1, sum2, sum3)
    return testOutputBuffer
}


func main() int { return 0 }
