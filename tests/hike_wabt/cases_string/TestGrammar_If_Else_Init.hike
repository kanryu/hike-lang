package main

import "std/fmt/sprintf"

var testOutputBuffer string = ""











func testOutput() string {
    if v := 15; v > 20 {
        testOutputBuffer += sprintf.Sprintf("HIGH\n")
    } else if v > 10 {
        testOutputBuffer += sprintf.Sprintf("MID=%d\n", v)
    } else {
        testOutputBuffer += sprintf.Sprintf("LOW\n")
    }
    return testOutputBuffer
}


func main() int { return 0 }
